# Único modelo versionado de variáveis da API. Três lugares recebem valores
# reais, nunca este arquivo:
#   - desenvolvimento: copie para .env (é o ÚNICO arquivo que a API lê;
#     .env.development, .env.production e .env.staging não são lidos por nada);
#   - staging e produção: a aba Environment do Application trajetto-api no
#     Dokploy (um Application por serviço, imagem do GHCR; docs/deploy.md).
#     Não há compose: o que está no Environment do Application é exatamente o
#     que o contêiner recebe;
#   - CI: os secrets e variables do GitHub.
# Cada variável, para que serve e o valor em cada ambiente:
# docs/variaveis-de-ambiente.md.
#
# Staging não tem arquivo próprio: é este mesmo modelo, preenchido no
# Application da API do environment staging do Dokploy. O que muda em relação
# à produção (APP_ENV=staging, a imagem `:staging` no lugar de `:stable`, o
# domínio, segredos e buckets R2 OUTROS, Meta e Resend de teste) está na
# "Matriz produção × staging" de docs/variaveis-de-ambiente.md. O bootstrap
# de um banco vazio (ALLOW_EMPTY_DATABASE_BOOTSTRAP em true) vai só na
# Application trajetto-api-migrate, ao preparar o banco; na API, sempre
# false. O deploy de staging roda a cada push na branch staging, assim que o
# environment staging do GitHub tiver os secrets do Dokploy.

NODE_ENV=development
# Qual implantação é esta: development, staging ou production. A imagem é
# sempre NODE_ENV=production, então é APP_ENV que distingue staging de
# produção. Vazio = segue o NODE_ENV. staging/production exigem
# NODE_ENV=production (staging roda as mesmas travas da produção).
APP_ENV=development
PORT=3333
# Optional (default info): fatal|error|warn|info|debug|trace|silent. One level
# for the request lines and every worker. `debug` adds per-socket connect and
# disconnect lines.
# LOG_LEVEL=info

# Optional: external dead man's switch pinged every minute by the ops heartbeat
# (healthchecks.io style; `<url>/fail` with the reasons when a rule breaks).
# HEALTHCHECK_FAIL_URL only for Uptime Kuma push monitors (?status=down).
# Empty: the reasons only go to the log. See docs/deploy.md (Alertas e monitoramento).
HEALTHCHECK_PING_URL=
HEALTHCHECK_FAIL_URL=

# connection_limit is explicit on purpose: without it each replica holds pg's
# default of 10 (Prisma 6: (cpus*2)+1), so N replicas silently multiply it and
# hit Postgres max_connections (100 by default). Prisma 7's pg driver reads
# none of these parameters itself: src/shared/database/pool-config.ts maps
# each one onto the pg Pool (docs/arquitetura.md, Conexão com o Postgres). Pin it and the ceiling becomes arithmetic: limit * replicas
# + workers < max_connections. Raise the limit only after PgBouncer is in front.
# pool_timeout=5 (it was 20): a request that finds the pool full gets its 503
# with Retry-After in 5 s instead of holding the client 20 s while the queue
# behind it grows; load shedding (SHED_MODE) refuses what can wait before it
# reaches the pool (plano-escala F2-24).
# Development: the ${...} pieces below are expanded by dotenv-expand (src/env).
# POSTGRES_USERNAME/PASSWORD/DATABASE also feed compose.development.yaml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DATABASE=trajetto
DATABASE_URL=postgresql://${POSTGRES_USERNAME}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DATABASE}?connection_limit=10&pool_timeout=5
# Staging and production: typed in the Applications' environment, literal
# values (no ${...}), HOST being the Internal Host of the Dokploy PostgreSQL
# database (its appName). The runtime URL is the DATABASE_URL of
# trajetto-api; the migration URL below is the DATABASE_URL of
# trajetto-api-migrate (the release step), under that name or as
# MIGRATION_DATABASE_URL, which wins when both are set. The query strings must be exactly these: on top of
# the pool, connect_timeout=5, socket_timeout=60 and
# max_idle_connection_lifetime=300 (a peer that goes silent must not hold a
# request for ~15 min) and the `options` ceilings (statement_timeout,
# lock_timeout, idle_in_transaction_session_timeout) on the runtime URL; the
# migration URL has none of them. pool-config.ts appends -c TimeZone=UTC to
# `options` on its own (the queues compare UTC columns with now()): leave
# TimeZone out, a value set here is kept and takes the API off UTC.
# docs/arquitetura.md (Conexão com o Postgres);
# tests/unitaires/lifecycle/database-dead-connection-params.test.ts and
# tests/E2E/runtime-database-*.test.ts read these two lines.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&connection_limit=10&pool_timeout=5&connect_timeout=5&socket_timeout=60&max_idle_connection_lifetime=300&options=-c%20statement_timeout%3D30000%20-c%20lock_timeout%3D5000%20-c%20idle_in_transaction_session_timeout%3D60000
# MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&connection_limit=2&connect_timeout=10

# The side pools (3 connections each, opened only when used): the heavy
# reads' bulkhead (10 s a statement) and the maintenance pool of the crons
# (30 min a statement; direct to Postgres, never PgBouncer). Empty, both use
# DATABASE_URL. After the cut of the database roles: trajetto_read and
# trajetto_batch (docs/deploy.md).
# DATABASE_READ_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&connection_limit=3
# BATCH_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&connection_limit=3

# The cut of the database roles (docs/deploy.md): the boot warns while the
# runtime connects as a superuser or as the tables' owner. true refuses that
# boot, and also one that runs the cron without BATCH_DATABASE_URL or whose
# batch login cannot SET ROLE trajetto_partitions. false (the default) until
# the URLs use the trajetto_* logins.
# DATABASE_REQUIRE_RUNTIME_ROLE=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}
# A Redis of its own for the pub/sub (the Socket.IO adapter and the wake
# between processes), only by the scale plan's trigger; the counters stay
# on REDIS_URL. Unset = REDIS_URL, as always.
# PUBSUB_REDIS_URL=redis://localhost:6380
# Staging and production: the Dokploy Redis database (password set, no
# external port), redis://:PASSWORD@HOST:6379 with HOST its Internal Host.
# The password goes inside the URL; hex (`openssl rand -hex 32`) needs no URL
# escaping.
# Optional. Prefix of the Socket.IO adapter's Pub/Sub channels (default
# socket.io). Pub/Sub ignores the database number in REDIS_URL, so this is the
# only thing that keeps two deployments sharing one Redis (e.g. staging and prod)
# from hearing each other's realtime. Changing it on a running cluster splits
# old and new replicas until the rollout ends. Letters, digits and . _ : - only.
# SOCKET_ADAPTER_KEY=socket.io
# Optional (default 2000, 100 to 30000; plano-escala F4-51). How long a
# cluster-wide question of the adapter (the chat's presence) waits for every
# replica before answering with what it has.
# SOCKET_ADAPTER_REQUESTS_TIMEOUT_MS=2000
# Optional (default 180000, min 1000). How often each replica re-checks, in the
# database, the sessions of the sockets connected to it (±25% jitter): the
# longest a revoked session keeps a socket whose revocation frame was lost.
# SOCKET_REVALIDATE_MS=180000
# Optional (plano-escala U-01). The socket admission of each replica: at most
# SOCKET_HANDSHAKE_MAX_INFLIGHT handshakes at once (default 64) and
# SOCKET_MAX_CONNECTIONS sockets held (default 5000). Past either, the
# handshake is refused with SOCKET_UNAVAILABLE and a retryAfterMs of 5-10 s
# the web and the app wait out, never charged to the address. 0 turns a
# ceiling off; SOCKET_MAX_CONNECTIONS=0 also drops the descriptors' part
# below (the rollback).
# SOCKET_HANDSHAKE_MAX_INFLIGHT=64
# SOCKET_MAX_CONNECTIONS=5000
# Optional (default 1024, plano-escala F5-31). File descriptors kept out of
# the socket ceiling: a replica holds at most its soft descriptor limit minus
# this, so the sockets never take what Postgres, Redis and HTTP need. 0
# leaves the descriptors out of the ceiling.
# SOCKET_FD_RESERVE=1024
# Optional (default true). Whether a driver's position also goes to the
# operations room, besides positions:<businessId>; U-03 turns it off once the
# web that subscribes to the positions room has been in production a week.
# SOCKET_POSITIONS_ON_OPERATIONS_ROOM=true
# Optional (default true). The shutdown closes the replica's sockets in slices
# over the drain (1/N a second) instead of all at once at its end. false is
# the rollback.
# SOCKET_GRADUAL_DRAIN=true

# Public URL of the WEB app (where /verificar lives): the only CORS origin,
# and the base the API builds links on — the proof PDF's verification link and
# QR code, the tracking page, e-mails and notifications. API_HTTP_REQUEST is
# the API's own public URL: the e-mails' logo is fetched from it
# (/assets/trajetto-logo.png), so in production it must be reachable from the
# internet. Empty = e-mails go without the logo.
HTTP_REQUEST=http://localhost:3000
API_HTTP_REQUEST=http://localhost:3333
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_SECRET_REFRESH_TOKEN=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET

# Optional. Lowest driver-app `contract` (CLIENT_CONTRACT in the app's
# utils/client-version.ts, raised by every release that changes what the app
# sends) still served: below it, 426 CLIENT_UPGRADE_REQUIRED, except sign-in,
# 2FA, refresh and logout. Empty = off. Only applies to builds that send
# x-trajetto-client-version; the web and older builds are never refused.
# MIN_MOBILE_CONTRACT=
# Optional. The `nextFlushAfterMs` POST /route/positions answers on a replica
# that is not pressed (15000-300000): twice it with the event loop over 70%,
# 300000 over 90%. 60000 is the app's own interval.
# POSITIONS_FLUSH_AFTER_MS=60000
# Optional, https only. The store page that 426 names as `storeUrl`, opened
# by the app when no over-the-air update fits its runtime. Empty = left out
# of the body (the app falls back to its own Play Store page).
# MOBILE_STORE_URL=

MASTER_USER_EMAIL=admin@example.com
MASTER_USER_INITIAL_PASSWORD=CHANGE_ME

# Meta WhatsApp Cloud API (official). In development use the test number from
# the Meta developer dashboard (WhatsApp > API Setup): it provides a temporary
# access token and a phone number id, and can message up to 5 verified numbers.
# Leave empty to run without WhatsApp — sends fail with a clear error.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# No longer read (plan of 02/11/2026, B1/B2): every notification and customer
# message goes out under its own fixed template, named in
# src/shared/notifications/whatsapp-templates.ts and
# src/shared/delivery/customer-whatsapp-templates.ts (17 + 4; the copy for
# Meta is docs/whatsapp-modelos.md). META_WHATSAPP_TEMPLATE_NAME and
# META_WHATSAPP_CUSTOMER_TEMPLATE_NAME stay in the schema until the rollout
# ends and have no effect.
META_WHATSAPP_TEMPLATE_NAME=trajetto_notification

# Graph API version of every WhatsApp call.
META_WHATSAPP_API_VERSION=v23.0

# Each company's daily WhatsApp quota (plano-escala F3-15b): messages per
# business day of the company, counted in Postgres. Past it, the message
# waits for the company's next day (no attempt spent, never an e-mail
# instead) and the admins get one bell notice that day. 0 = no quota.
# WHATSAPP_DAILY_QUOTA_PER_TENANT=0

# No longer read either (B2): see META_WHATSAPP_TEMPLATE_NAME above.
META_WHATSAPP_CUSTOMER_TEMPLATE_NAME=

# Numeric id of the WhatsApp Business Account (WABA) that owns the templates
# (Business Manager > WhatsApp accounts). Optional and not a secret: only the
# MASTER's provider readiness check (/health/providers) reads it, to say
# whether each template is APPROVED.
META_WHATSAPP_BUSINESS_ACCOUNT_ID=

# Meta status callbacks (POST /webhooks/whatsapp): the App Secret (App
# Dashboard > Settings > Basic) signs every callback, and the verify token is
# any string you also type in the dashboard's webhook setup. Leave empty to run
# without reconciliation: the receiver answers 404 and sends keep working.
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Expo project access token (expo.dev > Access tokens), sent as Bearer on
# every push and receipts query. Optional until "enhanced push security" is on
# in the Expo project; set it in both environments BEFORE turning that on.
EXPO_ACCESS_TOKEN=

RESEND_SECRET_KEY=
RESEND_FROM_EMAIL=
# Resend webhook signing secret (whsec_...) for POST /webhooks/resend, which
# records delivered/bounced/complained events. Empty: the receiver answers 404.
RESEND_WEBHOOK_SECRET=
# AI readings (receipt number/date, odometer) by the local OCR service
# trajetto-ai (docs/adr/0010; infra/ai-ocr). No external provider: the old
# ANTHROPIC_API_KEY / AI_ANTHROPIC_MODEL are gone, and AI_PROVIDER=anthropic
# now stops the boot. Start the service with
#   docker compose -f compose.development.yaml --profile ai up -d
# `none` switches the readings off; `local` without URL or token behaves the
# same. The token is the service's AI_TOKEN (32+ chars; this one is dev only,
# the same default as compose.development.yaml).
#
# Staging and production: trajetto-ai is its own Dokploy Application (no
# domain, internal port 8080), so the API Application's environment sets
#   AI_LOCAL_URL=http://<appName of the trajetto-ai Application>:8080
# (its service name on dokploy-network, shown in the panel) and
# AI_LOCAL_TOKEN (openssl rand -hex 32), the SAME value the trajetto-ai
# Application receives as AI_TOKEN. That Application also takes OCR_THREADS
# and AI_MAX_QUEUE (infra/ai-ocr/server.py); its CPU and memory limits are
# Swarm settings of that Application. Staging on the same host:
# AI_PROVIDER=none here and the AI Application stopped.
AI_PROVIDER=local
AI_LOCAL_URL=http://127.0.0.1:18080
AI_LOCAL_TOKEN=dev-only-token-0123456789abcdef0123
# One call's budget (must fit the 300 s lease) and reads in flight per
# replica (1-32; the pipeline takes the smaller of this and AI_CONCURRENCY).
# AI_LOCAL_TIMEOUT_MS=15000
# AI_LOCAL_MAX_CONCURRENCY=1

# What this process is (docs/deploy.md (Papéis da mesma imagem)):
# all | api | worker | scheduler | realtime | worker-external | ingest.
# A preset and a label; every variable below given explicitly wins over the
# preset, and the boot log ('process role resolved') names the overrides.
# Unset = all, the process that runs everything, as before. The roles
# without public traffic answer only /health*.
# PROCESS_ROLE=all
# Background workers (pipelines, webhook dispatcher, cron) on this process:
# the master switch. `false` only on HTTP replicas that have a worker
# service of the same image running with `true`.
# WORKERS_ENABLED=true
# The cron on this process; the queues it claims (outbox, internal,
# external, webhooks, ai, jobs, comma-separated, or `none`; unset = all).
# CRON_ENABLED=true
# WORKER_QUEUES=outbox,internal,external,webhooks,ai,jobs
# Whether Socket.IO admits connections here (`false` in the worker preset:
# the upgrade is refused; what the process emits still crosses the adapter).
# SOCKETS_ENABLED=true
# The sweeps: 30 s and 5 s by default; the worker preset sets 2 s for both.
# PIPELINE_SWEEP_INTERVAL_MS=30000
# WEBHOOK_SWEEP_INTERVAL_MS=5000
# Rows of each queue worked on at once by this process (1-32; unset = the
# constants of before). A lane or the webhooks below 2 no longer fit their
# lease and fail the boot; the boot warns when outbox + internal take the
# whole pool (connection_limit of DATABASE_URL).
# NOTIFICATION_INTERNAL_CONCURRENCY=5
# NOTIFICATION_EXTERNAL_CONCURRENCY=5
# OUTBOX_EXPANSION_CONCURRENCY=1
# WEBHOOK_CONCURRENCY=5
# AI_CONCURRENCY=4
# The providers' global concurrency caps (plano-escala F3-15a): sends in
# flight to Meta, the e-mail provider and Expo across every process that
# claims their lane (0-256; unset = 0 = no global cap, the lane's own
# concurrency per process). Each process takes the cap divided by the live
# processes of the lane, the most seen in 10 min and ROLE_EXPECTED_CONSUMERS
# (0-64; unset = 0), never below 1.
# WHATSAPP_GLOBAL_CONCURRENCY=0
# EMAIL_GLOBAL_CONCURRENCY=0
# PUSH_GLOBAL_CONCURRENCY=0
# ROLE_EXPECTED_CONSUMERS=0
# The providers' rate a second across every process (plano-escala F3-15c):
# a GCRA bucket in Redis per provider (0-1000; unset = 0 = off, a 429
# handled as before). A send more than a second from its place, or one the
# provider refused with a 429 (Meta's 130429), waits without spending an
# attempt. Without Redis, each process keeps rate / the lane's processes.
# Proposed once a 429 shows up: 60, 8 and 500.
# WHATSAPP_SENDS_PER_SECOND=0
# EMAIL_REQUESTS_PER_SECOND=0
# PUSH_NOTIFICATIONS_PER_SECOND=0
# Webhook calls in flight to one endpoint, per process (1-32; unset = 2).
# WEBHOOK_PER_ENDPOINT_CONCURRENCY=2
# Webhook calls in flight to one endpoint across every dispatcher
# (plano-escala F3-13; 0-64; unset = 4; 0 = the per-process cap only, the
# claim of before).
# WEBHOOK_ENDPOINT_GLOBAL_CONCURRENCY=4
# Webhook calls in flight to one destination host, across every endpoint
# pointed at it and every dispatcher (plano-escala F3-14; 0-256; unset = 16;
# 0 = off). Only with the cap per endpoint on.
# WEBHOOK_HOST_GLOBAL_CONCURRENCY=16
# The spreadsheet read on a worker thread: threads at once (0 = on the main
# thread, as before), each thread's heap ceiling in MB (64-768; unset =
# what the memory budget leaves per read, 256-768) and how long one read
# may take.
# SPREADSHEET_READS_PER_PROCESS=1
# SPREADSHEET_WORKER_MAX_OLD_MB=256
# SPREADSHEET_READ_TIMEOUT_MS=60000
# The spreadsheet import as a durable job (plano-escala F3-23a): true sends
# the file to storage and the import to the `jobs` queue, resumed from its
# cursor after a SIGKILL; false (the default) processes it in the memory of
# the replica that answered. The same value on every Application. Per
# company, IMPORT_RUNNING_PER_TENANT imports (1-4) run at once and
# IMPORT_QUEUED_PER_TENANT more (0-20) wait; past that, 429 IMPORT_BUSY.
# IMPORT_DURABLE_JOBS=false
# IMPORT_RUNNING_PER_TENANT=1
# IMPORT_QUEUED_PER_TENANT=5
# Rows per transaction of the durable import (plano-escala F3-23c), 1-500:
# a batch that fails is redone row by row; 1 is row by row.
# IMPORT_ROWS_PER_TRANSACTION=100
# The CPU pool (plano-escala F3-29): the NF-e parse and the Excel export's
# workbook on worker threads. Threads at most (0-8; 0 = in process, as
# before), calls waiting for a thread (1-256; past it, 503 CPU_POOL_BUSY),
# how long a call may wait and take (ms), and each thread's heap (MB, which
# the memory budget counts).
# CPU_POOL_THREADS=2
# CPU_POOL_MAX_PENDING=16
# CPU_POOL_TIMEOUT_MS=20000
# CPU_POOL_THREAD_MAX_OLD_MB=64
# The memory budget checked at boot: main heap + spreadsheet threads + this
# native reserve (MiB) against the container's memory.max. warn logs and
# alerts; enforce refuses the boot (docs/runbooks/memory-budget.md).
# NATIVE_RESERVE_MB=150
# MEMORY_BUDGET_MODE=warn

# The graceful shutdown (docs/deploy.md (Desligamento ordenado)).
# STOP_GRACE_PERIOD_MS is the Stop Grace Period the Swarm really gives the
# service, in ms (7000-300000): every deadline of the shutdown is derived
# from it. Empty: Docker's default 10 s, and the shutdown ends in under 9 s.
# 40000 only once `docker service inspect` shows the 40 s grace
# (verify-rollout fails the deploy when this passes the service's grace).
# The four overrides are optional; one that does not fit fails the boot.
# STOP_GRACE_PERIOD_MS=10000
# SHUTDOWN_TIMEOUT_MS=
# SHUTDOWN_DRAIN_MS=
# IMPORT_DRAIN_GRACE_MS=
# SHUTDOWN_WORKERS_MS=

# How many requests one keep-alive connection serves before its response
# says `Connection: close`, so a replica added by a scale-up gets its share
# (the Swarm spreads connections, not requests). 0 turns the cap off.
# HTTP_MAX_REQUESTS_PER_SOCKET=1000

# One ops_sample row per process per minute, the scale plan's series
# (docs/deploy.md (Séries de operação)). `false` stops only the write; the
# minute log line stays.
# OPS_SAMPLE_ENABLED=true

# The ops heartbeat's database rules (docs/deploy.md (Dead man's switch)).
# PITR_EXPECTED=true makes archive_mode other than on page; switch it on only
# after the environment's pgBackRest setup (docs/deploy.md, section 27: the
# last step of the F1a and of the F1b). A write open longer than
# LONG_WRITE_XACT_ALERT_SECONDS (10-3600) pages; pg_wal past PG_WAL_ALERT_GIB
# pages (8 on the single VPS).
# PITR_EXPECTED=false
# LONG_WRITE_XACT_ALERT_SECONDS=120
# PG_WAL_ALERT_GIB=12

# The integration feed's floor (docs/runbooks/delivery-event-writer-bound.md):
# each page of /integration/v1/events starts at the created_at of the last
# event served minus this margin, in ms. A trigger refuses an INSERT into
# delivery_event more than 240 s into its transaction, so the boot refuses
# less than twice that (480000).
# FEED_FLOOR_MARGIN_MS=600000

# The order of /integration/v1/events: "id" (the default, as every release
# before this one) or "commit" (commit order, with the v2 cursor; switch it
# only once this release serves alone: the image before it cannot read a v2
# cursor). /deliveries and /routes answer sync_watermark this many ms behind
# the request (at least 60000).
# INTEGRATION_FEED_ORDER=id
# SYNC_WATERMARK_MARGIN_MS=120000

# The ramp's gauge (docs/runbooks/volume-near-gate.md): the last 7 days of
# deliveries, projected to a month, past 70% of
# APPROVED_GATE_MONTHLY_DELIVERIES (the step a load report in docs/desempenho
# approved) alert; so do the last 24 h past PLATFORM_DAILY_DELIVERY_SOFT_CAP
# (empty = no cap). Only alerts: nothing is refused.
# APPROVED_GATE_MONTHLY_DELIVERIES=10000
# PLATFORM_DAILY_DELIVERY_SOFT_CAP=

# Statements the hourly pg_stat_statements snapshot keeps (pgss_snapshot), the
# most expensive of the hour (1-5000).
# PGSS_SNAPSHOT_TOP=200

# Days the series are kept (ops_sample, pgss_snapshot); the nightly purge
# (04:40 UTC) removes older rows. 14 to 3650.
# OPS_SAMPLE_RETENTION_DAYS=30
# PGSS_SNAPSHOT_RETENTION_DAYS=30

# The GPS trail's partitions: days of driver_position kept (1-3650; lower
# it only with the trail archive on, a dropped day is gone) and days of
# partitions made ahead by the nightly partition-maintenance job (7-60).
# DRIVER_POSITION_RETENTION_DAYS=90
# DRIVER_POSITION_PARTITION_LOOKAHEAD_DAYS=7

# Days of the four queues' daily partitions made ahead (7-60), once the swap
# (plano-escala F5-09) made them partitioned; nothing changes before it.
# QUEUE_PARTITION_LOOKAHEAD_DAYS=7

# The trail's archive (plano-escala F2-11): with true, the partition job
# copies a day of the trail to the ARCHIVE bucket (one gzipped CSV per
# company, trail/<yyyymmdd>/<businessId>.csv.gz) and drops it only when the
# copy adds up; enabled without the bucket or the token, it keeps every
# expired day. Its own bucket and token, never the uploads' ones, on the
# uploads' R2 account. STANDARD or STANDARD_IA. The retention is the
# bucket's Expiration rule on trail/, set by hand in R2 to the same number.
# TRAIL_ARCHIVE_ENABLED=false
# TRAIL_ARCHIVE_BUCKET=
# ARCHIVE_R2_ACCESS_KEY_ID=
# ARCHIVE_R2_SECRET_ACCESS_KEY=
# ARCHIVE_STORAGE_CLASS=STANDARD_IA
# TRAIL_ARCHIVE_RETENTION_DAYS=180

# Days the trail's submission keys (delivery_event_submission) are kept; the
# nightly purge (04:45 UTC) removes older rows. 30 to 3650.
# DELIVERY_EVENT_SUBMISSION_RETENTION_DAYS=90

# The status lines a delivery gets by itself (plano-escala F2-06): its
# creation, and what a route moves on its own. Off until no image from before
# wave 7 serves any more (it reads those lines wrongly); docs/deploy.md.
# DELIVERY_STATUS_TRAIL_ENABLED=false

# Days the notification family (outbox events, deliveries, receipts) is
# kept (plano-escala F5-11): once partitioned, a day leaves whole after it,
# settled and with its failures in the dead letters. 30 to 90.
# OUTBOX_PUBLISHED_RETENTION_DAYS=30

# Days a queue's partition may stay past its retention before the
# partition-stuck alert (1 to 30).
# QUEUE_PARTITION_STUCK_ALERT_DAYS=3

# The claims' floor of ids in flight (plano-escala F5-13): true prunes, on
# the partitioned queues, the days that hold nothing to claim. Off until the
# plans are measured on staging.
# QUEUE_CLAIM_ID_FLOOR_ENABLED=false

# The fair claim by company (plano-escala F3-10, F3-11 and F3-12): the
# delivery lanes, the outbox and the AI queue (receipts first) take their
# rows company by company, from a rotating cursor, at most
# QUEUE_FAIR_ROWS_PER_TENANT of one company (1-20) and QUEUE_FAIR_MAX_TENANTS
# companies (1-512) per claim. Off until measured on staging.
# QUEUE_FAIR_CLAIM_ENABLED=false
# QUEUE_FAIR_ROWS_PER_TENANT=2
# QUEUE_FAIR_MAX_TENANTS=64

# Days a finished durable job is kept (plano-escala F3-22): a success
# (SUCCEEDED) and a failure (FAILED, CANCELLED), counted from when it ended,
# before the nightly cleanup-background-jobs removes it.
# BACKGROUND_JOB_SUCCEEDED_RETENTION_DAYS=30
# BACKGROUND_JOB_FAILED_RETENTION_DAYS=90

# Days between scheduling a company's purge and the purge (plano-escala
# F3-25), 8-365: the company is inactive meanwhile and can be reactivated.
# TENANT_PURGE_AFTER_DAYS=30

# Whether the purge of a company (plano-escala F3-26a) deletes its GPS
# trail at once instead of leaving it to the DROP of the trail's days.
# TENANT_PURGE_TRAIL_NOW=false

# Days the webhook ledger keeps a row (plano-escala F5-12): the settled
# ones older leave, by day once partitioned. 31 (the 30-day replay window
# plus a day of grace) to 365.
# WEBHOOK_DELIVERY_RETENTION_DAYS=31

# Days a failed outbox event and a failed delivery stay in their dead
# letters, counted from the failure; the nightly purge (03:30 UTC) removes
# older ones. 31 to 3650, and over OUTBOX_PUBLISHED_RETENTION_DAYS.
# OUTBOX_FAILED_RETENTION_DAYS=90

# Days the bell keeps a read and an unread notification; the nightly
# cleanup-user-history (04:00 UTC) removes older ones. 30 to 3650.
# NOTIFICATION_READ_RETENTION_DAYS=90
# NOTIFICATION_UNREAD_RETENTION_DAYS=180

# Days the chat keeps a message (plano-escala U-08): with a number, the
# nightly purge-chat-messages (04:25 UTC) deletes older messages and their
# attachments. Unset = never (the default). 365 to 3650; under 365 the boot
# refuses it. Only after a lawyer's review (decision D12).
# CHAT_MESSAGE_RETENTION_DAYS=

# Which node, slot and service this task is, for the log lines and the
# ops_sample row. In the Dokploy Environment, typed literally as the Swarm's
# templates (the Swarm renders them per task); a value still holding "{{"
# counts as absent. Unset, nothing changes.
# SWARM_NODE_HOSTNAME={{.Node.Hostname}}
# SWARM_TASK_SLOT={{.Task.Slot}}
# SWARM_SERVICE_NAME={{.Service.Name}}

# Production must use a private R2 bucket. Objects are returned through
# short-lived signed URLs; do not configure a public bucket/domain.
UPLOAD_STORAGE_TYPE=local
UPLOAD_LOCAL_PATH=./tmp
UPLOAD_SIGNED_URL_TTL_SECONDS=900
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Só para testes: um endpoint S3-compatível (o MinIO local do E2E de upload,
# tests/support/minio/minio-test.sh) no lugar do R2 da conta. Vazio em produção.
# R2_ENDPOINT=
# Coletor noturno de objetos do bucket que nenhuma linha referencia (só os de
# 30 a 33 dias). dry-run (padrão) só conta e registra no log; delete apaga;
# off desliga. Leia alguns resumos do dry-run antes de ligar o delete.
UPLOAD_ORPHAN_GC=dry-run
# Opcional. Apaga da trilha de auditoria (activity) o que tiver mais de N dias.
# Vazio = nunca apaga. Menos de 365 é recusado (a trilha é prova).
# ACTIVITY_RETENTION_DAYS=
# Expurgos noturnos. Um expurgo para no orçamento e, com sobra, termina
# FAILED "[partial]"; o catch-up de hora em hora o repete só dentro da janela
# (UTC, depois dos backups das 05:00) e no máximo N vezes no dia. O orçamento
# vai até 300000 (metade do lease de 10 min do cron); acima, o boot recusa.
# CRON_PURGE_RUN_BUDGET_MS=300000
# CRON_PARTIAL_RETRY_WINDOW_UTC=06:00-09:00
# CRON_PARTIAL_RETRIES_PER_DAY=3
# Dias em que o link público do comprovante (QR impresso, sem login) continua
# abrindo o PDF, contados da geração do documento. Depois responde 404, como um
# token que não existe. Padrão 1825 (5 anos, a guarda fiscal da NF-e).
PROOF_VERIFICATION_TTL_DAYS=1825
# Assinatura ICP-Brasil do comprovante (decisão 14.8). O certificado A1 (e-CNPJ)
# da plataforma, em PFX: base64 OU caminho de um arquivo montado como secret,
# nunca os dois. SEGREDOS: nunca no repositório nem em log. Sem eles, o PDF sai
# "sem assinatura digital" e diz isso. A razão social e o CNPJ impressos num
# documento assinado vêm do próprio certificado.
# Em staging/produção, cada variável deste bloco vai direto no Environment do
# Application da API no Dokploy; sem o certificado lá, os PDFs saem sem
# assinatura (e dizem isso).
# PROOF_SIGNING_PFX_BASE64=
# PROOF_SIGNING_PFX_PATH=/run/secrets/proof_signing.pfx
# PROOF_SIGNING_PFX_PASSWORD=
# pades-ad-rb (ICP-Brasil AD-RB v1.1, padrão) ou cms (o CMS simples do modelo).
# PROOF_SIGNATURE_PROFILE=pades-ad-rb
# true desliga a assinatura sem remover o certificado (incidente).
# PROOF_SIGNING_DISABLED=false
# PROOF_SIGNER_LOCATION=Rio de Janeiro, RJ
# PROOF_SIGNER_CONTACT=suporte@trajetto.com.br
# PROOF_SIGNER_BRAND=TRAJETTO
# Quem gerou um comprovante SEM assinatura. Sem CNPJ, o texto o omite.
# PROOF_ISSUER_LEGAL_NAME=Trajetto Sistemas Ltda
# PROOF_ISSUER_CNPJ=
# Mapa estático do comprovante: template XYZ {z}/{x}/{y} (https). Pode levar a
# chave do provedor (SEGREDO). O crédito é obrigatório com a URL. Em produção,
# tile.openstreetmap.org é recusado.
# PROOF_MAP_TILE_URL=
# PROOF_MAP_TILE_ATTRIBUTION=© OpenStreetMap
# PROOF_MAP_TIMEOUT_MS=3000
# Mapa de fundo do mapa ao vivo do app (onda 5), entregue por GET /config/map:
# as MESMAS quatro variáveis da web, com os mesmos valores. Modelo do Leaflet,
# https com {z}, {x} e {y} ({s} opcional; http só em desenvolvimento) num host
# só, que o CSP da página do mapa do app consiga nomear (sem curinga,
# credenciais, IPv6, aspas nem espaços; até 1024 caracteres); modelo inválido
# derruba o boot e, fora de desenvolvimento, tile.openstreetmap.org é
# recusado. A URL pode levar a chave do provedor (todo cliente logado a
# recebe, como todo navegador recebe a da web: restrinja por origem no
# provedor). O crédito é texto simples; a API o escapa. Vazio: em desenvolvimento, o
# OpenStreetMap público; em staging e produção, o app desenha os marcadores sem
# mapa de fundo. O estilo escuro é opcional: sem crédito próprio, repete o do
# claro; sem ele, o app recolore os tiles claros.
# MAP_TILE_URL=
# MAP_TILE_ATTRIBUTION=
# MAP_TILE_URL_DARK=
# MAP_TILE_ATTRIBUTION_DARK=
# Geocodificação reversa do GPS do comprovante (protocolo Nominatim). Vazio =
# desligada: o PDF imprime o endereço cadastrado, com rótulo. Em produção,
# nominatim.openstreetmap.org é recusado. A chave é SEGREDO.
# REVERSE_GEOCODER_URL=
# REVERSE_GEOCODER_KEY=
# REVERSE_GEOCODER_KEY_PARAM=key
# REVERSE_GEOCODER_USER_AGENT=
# REVERSE_GEOCODER_TIMEOUT_MS=2500
# Geocodificação dos endereços das entregas (plano de 02/11/2026, E1): quantas
# consultas por dia (UTC) o job geocode-deliveries faz, somando as réplicas, no
# provedor acima (sem ele o job não roda). A cota é a mesma da geocodificação
# reversa do comprovante. 0 desliga o job.
# DELIVERY_GEOCODING_DAILY_BUDGET=2000
# Taxas do provedor do geocodificador, somando réplicas e caminhos (plano de
# escala F2-31). Os padrões são os do LocationIQ grátis (2/s, 60/min): 1 por
# segundo, 50 em 60 s para a busca do painel e 40 para o job e a busca depois
# do commit (nunca acima dos 50). Um plano pago sobe por aqui (decisão D40).
# GEOCODING_CALLS_PER_SECOND=1
# GEOCODING_CALLS_PER_MINUTE=50
# GEOCODING_BACKGROUND_CALLS_PER_MINUTE=40
# Entregas por reserva do job e quanto tempo uma execução reserva de novo
# enquanto o lote volta cheio (abaixo do minuto).
# DELIVERY_GEOCODING_BATCH_SIZE=20
# DELIVERY_GEOCODING_RUN_BUDGET_MS=50000
# Por quantos dias o NOT_FOUND ou o COARSE do provedor para uma porta vale para
# as outras entregas da mesma empresa ali (plano de escala F2-33). 0 desliga.
# GEOCODING_VERDICT_REUSE_DAYS=30
# Geocodificação reversa do comprovante (plano de escala F2-32): chamadas por
# segundo só dela, além das acima, e consultas por dia (UTC); 0 desliga a
# consulta (o PDF imprime o endereço cadastrado, com rótulo).
# GEOCODING_PROOF_RESERVED_PER_SECOND=1
# PROOF_REVERSE_DAILY_BUDGET=1500
# O plano do LocationIQ contratado (decisão D40). Com eles, o boot recusa
# taxas ou orçamentos acima de 90% do plano, e o ops-heartbeat alerta
# geocoding-quota-high com o dia acima de 70% da cota. Vazios, nada é conferido.
# LOCATIONIQ_RATE_PER_SECOND=
# LOCATIONIQ_DAILY_QUOTA=
# Busca de endereço do painel ("Fixar no mapa" da página da rota): GET
# /address-search/:businessId pede sugestões ao provedor enquanto o despachante
# digita. URL própria: o autocomplete do LocationIQ fica em
# https://api.locationiq.com/v1 (com ADDRESS_SEARCH_PROTOCOL=
# locationiq-autocomplete), não no host regional da REVERSE_GEOCODER_URL.
# nominatim-search é para um Nominatim nosso ou para desenvolvimento; em
# produção, nominatim.openstreetmap.org é recusado. Vazio = busca desligada (a
# rota responde 503 e o clique no mapa continua fixando). A chave é SEGREDO;
# vazia, vale a REVERSE_GEOCODER_KEY (a mesma conta). DAILY_BUDGET é o teto do
# dia (UTC) da plataforma, separado do orçamento do job (0 desliga);
# BUSINESS_DAILY_LIMIT, o de cada empresa; CACHE_SECONDS, quanto a resposta
# fica guardada por empresa (até 172800 = 48 h, o máximo do plano grátis).
# Conta do plano grátis (5.000/dia, 2/s, 60/min): job 2000 + busca 1000 +
# reversa do comprovante 1500 = 90% do dia. As contagens do dia ficam no
# Postgres (provider_quota_day).
# ADDRESS_SEARCH_URL=
# ADDRESS_SEARCH_PROTOCOL=nominatim-search
# ADDRESS_SEARCH_KEY=
# ADDRESS_SEARCH_DAILY_BUDGET=1000
# ADDRESS_SEARCH_BUSINESS_DAILY_LIMIT=150
# ADDRESS_SEARCH_CACHE_SECONDS=172800
# The internal reference at /docs.
#
# Outside production it is open. In production it answers 404 unless BOTH of
# these are set, and then only behind HTTP Basic: /docs describes every
# endpoint of the product, including the ones only a master can call.
#
# The public integration reference is a different page and stays open:
# /integration/docs, built by subtraction and limited to what an API key
# reaches.
#
# DOCS_PASSWORD needs at least 20 characters; a shorter one keeps /docs closed
# (404) and the boot logs why.
DOCS_USER=
DOCS_PASSWORD=

# Abre GET /health/rollout (o estado da etapa de release), que o pipeline lê
# com o mesmo valor (secret ROLLOUT_STATUS_TOKEN do environment do GitHub)
# para rodar a etapa de novo quando um passo ficou pendente. Vazio, ou com
# menos de 32 caracteres: a rota responde 404 a todos e o deploy segue como
# antes. Um valor por ambiente. Gere com: openssl rand -hex 32
ROLLOUT_STATUS_TOKEN=

# Cloudflare Turnstile no formulário público de orçamento, verificado pela
# PRÓPRIA API (o mesmo segredo do web). Com o segredo, pedido sem token é
# recusado (400 TURNSTILE_REQUIRED) e o token enviado é conferido na
# Cloudflare. Vazio: Turnstile desligado.
TURNSTILE_SECRET_KEY=

# De onde vem o endereço do cliente nas rotas ANÔNIMAS (login, 2FA,
# recuperação de senha). Decide o balde do rate limit dessas rotas.
#
#   none       -> só o socket. Correto SEM proxy nenhum na frente. Atrás de um,
#                 põe a internet toda num balde e o limite de login vira
#                 negação de serviço contra todo mundo.
#   xff        -> X-Forwarded-For, ÚLTIMA entrada (o par que o Traefik viu).
#                 Certo quando o Traefik/nginx É a borda. Atrás da Cloudflare
#                 o par é a borda dela, e todo mundo cai num balde só.
#   cloudflare -> CF-Connecting-IP, mas SÓ quando o par que o Traefik viu é da
#                 Cloudflare (faixas em src/config/trusted-edge.ts); fora
#                 disso vale o par, igual a `xff`. É o valor da produção.
#
# Fora de produção, ausente vale `none`. Em produção é OBRIGATÓRIA (o boot
# falha sem ela); atrás da Cloudflare, use `cloudflare`. Ver
# docs/deploy.md (Domínios, TLS e a borda).
RATE_LIMIT_TRUSTED_PROXY=none

# Opcional (mínimo 32 caracteres). Valor que uma Transform Rule das nossas
# zonas na Cloudflare põe no cabeçalho `x-trajetto-edge-secret`. Com ele, o
# modo `cloudflare` só acredita no CF-Connecting-IP que vem junto — um Worker
# de outra conta sai das mesmas faixas e não conhece o segredo.
# Gere com: openssl rand -hex 32
RATE_LIMIT_EDGE_SECRET=

# Segredo compartilhado com o servidor do Next.js (mínimo 32 caracteres; o
# mesmo valor vai no .env da web). Login, 2FA, recuperação de senha, refresh e
# rastreio público chegam pelo SERVIDOR da web, então sem isto todo usuário web
# conta como um endereço só para os limites dessas rotas.
# Gere com: openssl rand -hex 32
RATE_LIMIT_FORWARDER_SECRET=

# Opcional. Descarte de carga (plano de escala F2-24): o que uma réplica
# ocupada (laço de eventos acima de 95% ou com 300 ms de atraso, ou mais
# pedidos esperando conexão do banco do que o pool tem) faz com o que pode
# esperar. `observe` (padrão) só conta, na seção `shedding` do
# /health/metrics e do ops_sample; `enforce` responde 503 SERVICE_BUSY com
# Retry-After. Fica em observe por 7 dias antes do enforce.
# SHED_MODE=observe
# Opcional. As posições do GPS dentro do enforce (F2-25): `auto` (padrão) só
# as recusa enquanto 90% dos envios dos últimos 10 min da réplica vierem do
# app com contrato 8 ou maior (o que espera o Retry-After); `observe` nunca
# as recusa; `enforce` recusa qualquer que seja a adoção.
# SHED_POSITIONS_MODE=auto
# Opcional. Orçamento do painel por empresa (F2-28): unidades por minuto que
# as sessões do painel de uma empresa gastam (detalhe 1, Torre 3, lista 5 ou
# 10 sem período, exportação 20), cada pessoa até TENANT_PANEL_USER_SHARE
# dele, cobrada antes da busca da sessão. Motorista e MASTER não pagam.
# `observe` (padrão) só conta, na seção `panel_budget` do /health/metrics;
# `enforce` responde 429 TENANT_BUSY com Retry-After; `off` não gasta nada.
# TENANT_PANEL_BUDGET_MODE=observe
# TENANT_PANEL_BUDGET_PER_MINUTE=6000
# TENANT_PANEL_USER_SHARE=0.25
# Opcional. Até que linha uma listagem do painel pagina (F2-30): a página
# que começa nela ou depois responde 400 LIST_OFFSET_TOO_DEEP, que manda
# filtrar ou exportar. A web prende o pager no mesmo número. 0 desliga.
# LIST_MAX_OFFSET=10000
# Opcional. As listagens de atividades com período (F2-19): quanto antes do
# primeiro dia elas olham pelo id, que mantém a leitura nos meses do
# período depois que a activity vira particionada (0 desliga o piso), e
# até quantas linhas a tabela conta (acima disso, "10.000+"; 0 conta tudo).
# ACTIVITY_ID_FLOOR_MARGIN_MS=172800000
# ACTIVITY_COUNT_CAP=10000

# Opcional. Chave que cifra em repouso (AES-256-GCM) o segredo de assinatura e
# os cabeçalhos dos endpoints de webhook dos clientes. Base64 de 32 bytes.
# Vazia: fora de produção vale uma chave fixa de desenvolvimento; em produção
# os valores ficam em claro (o boot avisa). Guarde uma cópia FORA dos backups
# do banco: perdê-la torna ilegíveis os segredos cifrados.
# Gere com: openssl rand -base64 32
WEBHOOK_SECRETS_KEY=

# --- Processo (raramente mudam) -------------------------------------------
#
# Quanto o boot espera o Postgres responder antes de desistir (ms).
# WAIT_FOR_POSTGRES_TIMEOUT_MS=120000
# Threads do libuv (bcrypt, gzip, fs, dns). Definido no Dockerfile (8); só
# mude com medição.
# UV_THREADPOOL_SIZE=8
# Commit do build, que GET /health/liveness devolve em `version`/`commit`.
# Gravado na imagem pelo pipeline (build arg GIT_SHA); nunca defina à mão.
# Vazio = `dev`.
# APP_COMMIT_SHA=

# --- Só staging e produção (Environment do Application da API no Dokploy) --
# Em dev ficam vazias. Imagem (`:stable` em produção, `:staging` em staging),
# domínio, réplicas, limite de memória, healthcheck e ordem do update são
# campos do Application, não variáveis: docs/deploy.md.
#
# O teto de heap do Node acompanha o limite de memória do Application e
# entra no orçamento de memória que o boot confere (heap + threads da
# planilha + NATIVE_RESERVE_MB ≤ o Memory; docs/runbooks/memory-budget.md):
# com 1024M e a planilha em 256, 576 aqui no Environment (768 antes da
# onda 12 do plano de escala). Num .env de dev não vale: o Node lê o
# NODE_OPTIONS antes de o dotenv carregar o arquivo.
# NODE_OPTIONS=--max-old-space-size=576
#
# MIGRATION_DATABASE_URL (o modelo está junto da DATABASE_URL, acima): URL sem
# os tetos de runtime para o `prisma migrate deploy` e os seeds da etapa de
# release. Em staging e produção a etapa é a Application
# trajetto-api-migrate do Dokploy, com essa URL na própria DATABASE_URL; a
# API não migra no boot e não lê esta variável. Vazia = usa a
# DATABASE_URL. Ver docs/deploy.md (Migrations). Os builds da API anteriores
# a 31/10/2026 migravam no boot por padrão: enquanto um deles puder ser alvo
# de rollback, o Environment das Applications trajetto-api leva
# RUN_MIGRATIONS_ON_BOOT em false (docs/variaveis-de-ambiente.md, seção 2).
# `true` UMA vez, para preparar o banco vazio de uma instalação nova, no
# Environment da trajetto-api-migrate (docs/deploy.md, seção 8, passo 4; na
# API fica `false`): em produção o boot e a etapa de release recusam um
# banco sem nenhuma migration aplicada (banco novo ou restaurado vazio). Ver
# docs/deploy.md (Backup e restauração).
# ALLOW_EMPTY_DATABASE_BOOTSTRAP=false
#
# prisma/concurrent, os índices de tabela quente construídos com CREATE INDEX
# CONCURRENTLY ANTES das migrations (infra/scripts/prebuild-online-ddl.ts; a
# etapa recusa uma URL do PgBouncer, porta 6432 ou pgbouncer=true). Só no
# Environment da trajetto-api-migrate; vazias valem os padrões, e um valor
# inválido vale o padrão com aviso no log. `off` desliga o passo, só em
# emergência: as migrations passam a construir os índices segurando as
# escritas. Cada espera de lock dura até PREBUILD_LOCK_TIMEOUT_MS e é
# repetida PREBUILD_LOCK_RETRIES vezes antes de a etapa falhar.
# PREBUILD_ONLINE_DDL=on
# PREBUILD_LOCK_TIMEOUT_MS=3000
# PREBUILD_LOCK_RETRIES=20
#
# Depois das migrations a etapa roda infra/sql (roles, donos e grants) e
# prisma/post-deploy (DDL com pré-condição), com o estado de cada passo em
# release_step_state (infra/scripts/release-steps.ts). `off`, só no
# Environment da trajetto-api-migrate e só em emergência, pula o
# prisma/post-deploy; o infra/sql roda sempre.
# POST_DEPLOY_STEPS=on
# A janela do histórico (plano de escala F2-17, D39): os passos que copiam
# delivery_event e activity para as tabelas particionadas só rodam dentro
# deste intervalo, dois instantes ISO com fuso separados por / e no máximo
# 24 h. Só no Environment da trajetto-api-migrate, digitado no começo da
# janela e apagado depois. Vazia (o normal): a janela não roda.
# HISTORY_WINDOW_APPROVED=2026-12-06T06:00:00Z/2026-12-06T07:30:00Z
# Só para o ensaio de restore (infra/scripts/restore-postgres.sh): a imagem
# exata do Postgres do Dokploy (campo Docker Image do banco). Sem ela, a tag.
# POSTGRES_IMAGE=postgres:16-alpine
#
# Backup do banco: o dump não tem variável. É o Backup do próprio Database do
# Dokploy (aba Backups do PostgreSQL, destino S3 no Cloudflare R2), configurado
# no painel. Ver docs/deploy.md (Backup e restauração).
#
# O PITR (pgBackRest) e a memória do banco também não são variáveis da API: a
# imagem trajetto-postgres lê as dela (o teto em MiB, as do pgBackRest, o
# interruptor do arquivamento e as do ensaio) no Environment do Database
# PostgreSQL, com Command e Args vazios. Ver docs/variaveis-de-ambiente.md
# (seção 14) e docs/deploy.md (seção 27).
