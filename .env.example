# Único modelo versionado de variáveis da API. Três lugares recebem valores
# reais, nunca este arquivo:
#   - desenvolvimento: copie para .env (é o ÚNICO arquivo que a API lê;
#     .env.development, .env.production e .env.staging não são lidos por nada);
#   - staging e produção: a aba Environment do Application trajetto-api no
#     Dokploy (um Application por serviço, imagem do GHCR; docs/deploy.md).
#     Não há compose: o que está no Environment do Application é exatamente o
#     que o contêiner recebe;
#   - CI: os secrets e variables do GitHub.
# Cada variável, para que serve e o valor em cada ambiente:
# docs/variaveis-de-ambiente.md.
#
# Staging não tem arquivo próprio: é este mesmo modelo, preenchido no
# Application da API do environment staging do Dokploy. O que muda em relação
# à produção (APP_ENV=staging, a imagem `:staging` no lugar de `:stable`, o
# domínio, segredos e buckets R2 OUTROS, Meta e Resend de teste,
# ALLOW_EMPTY_DATABASE_BOOTSTRAP=true só no primeiro boot) está na "Matriz
# produção × staging" de docs/variaveis-de-ambiente.md. O deploy de staging
# roda a cada push na branch staging, assim que o environment staging do
# GitHub tiver os secrets do Dokploy.

NODE_ENV=development
# Qual implantação é esta: development, staging ou production. A imagem é
# sempre NODE_ENV=production, então é APP_ENV que distingue staging de
# produção. Vazio = segue o NODE_ENV. staging/production exigem
# NODE_ENV=production (staging roda as mesmas travas da produção).
APP_ENV=development
PORT=3333
# Optional (default info): fatal|error|warn|info|debug|trace|silent. One level
# for the request lines and every worker. `debug` adds per-socket connect and
# disconnect lines.
# LOG_LEVEL=info

# Optional: external dead man's switch pinged every minute by the ops heartbeat
# (healthchecks.io style; `<url>/fail` with the reasons when a rule breaks).
# HEALTHCHECK_FAIL_URL only for Uptime Kuma push monitors (?status=down).
# Empty: the reasons only go to the log. See docs/deploy.md (Alertas e monitoramento).
HEALTHCHECK_PING_URL=
HEALTHCHECK_FAIL_URL=

# connection_limit is explicit on purpose: without it each replica holds pg's
# default of 10 (Prisma 6: (cpus*2)+1), so N replicas silently multiply it and
# hit Postgres max_connections (100 by default). Prisma 7's pg driver reads
# none of these parameters itself: src/shared/database/pool-config.ts maps
# each one onto the pg Pool (docs/arquitetura.md, Conexão com o Postgres). Pin it and the ceiling becomes arithmetic: limit * replicas
# + workers < max_connections. Raise the limit only after PgBouncer is in front.
# Development: the ${...} pieces below are expanded by dotenv-expand (src/env).
# POSTGRES_USERNAME/PASSWORD/DATABASE also feed compose.development.yaml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DATABASE=trajetto
DATABASE_URL=postgresql://${POSTGRES_USERNAME}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DATABASE}?connection_limit=10&pool_timeout=20
# Staging and production: typed in the API Application's environment, literal
# values (no ${...}), HOST being the Internal Host of the Dokploy PostgreSQL
# database (its appName). The query strings must be exactly these: on top of
# the pool, connect_timeout=5, socket_timeout=60 and
# max_idle_connection_lifetime=300 (a peer that goes silent must not hold a
# request for ~15 min) and the `options` ceilings (statement_timeout,
# lock_timeout, idle_in_transaction_session_timeout) on the runtime URL; the
# migration URL has none of them. pool-config.ts appends -c TimeZone=UTC to
# `options` on its own (the queues compare UTC columns with now()): leave
# TimeZone out, a value set here is kept and takes the API off UTC.
# docs/arquitetura.md (Conexão com o Postgres);
# tests/unitaires/lifecycle/database-dead-connection-params.test.ts and
# tests/E2E/runtime-database-*.test.ts read these two lines.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&connection_limit=10&pool_timeout=20&connect_timeout=5&socket_timeout=60&max_idle_connection_lifetime=300&options=-c%20statement_timeout%3D30000%20-c%20lock_timeout%3D5000%20-c%20idle_in_transaction_session_timeout%3D60000
# MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&connection_limit=2&connect_timeout=10

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}
# Staging and production: the Dokploy Redis database (password set, no
# external port), redis://:PASSWORD@HOST:6379 with HOST its Internal Host.
# The password goes inside the URL; hex (`openssl rand -hex 32`) needs no URL
# escaping.
# Optional. Prefix of the Socket.IO adapter's Pub/Sub channels (default
# socket.io). Pub/Sub ignores the database number in REDIS_URL, so this is the
# only thing that keeps two deployments sharing one Redis (e.g. staging and prod)
# from hearing each other's realtime. Changing it on a running cluster splits
# old and new replicas until the rollout ends. Letters, digits and . _ : - only.
# SOCKET_ADAPTER_KEY=socket.io
# Optional (default 180000, min 1000). How often each replica re-checks, in the
# database, the sessions of the sockets connected to it (±25% jitter): the
# longest a revoked session keeps a socket whose revocation frame was lost.
# SOCKET_REVALIDATE_MS=180000

# Public URL of the WEB app (where /verificar lives): the only CORS origin,
# and the base the API builds links on — the proof PDF's verification link and
# QR code, the tracking page, e-mails and notifications. API_HTTP_REQUEST is
# the API's own public URL: the e-mails' logo is fetched from it
# (/assets/trajetto-logo.png), so in production it must be reachable from the
# internet. Empty = e-mails go without the logo.
HTTP_REQUEST=http://localhost:3000
API_HTTP_REQUEST=http://localhost:3333
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_SECRET_REFRESH_TOKEN=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET

# Optional. Lowest driver-app `contract` (CLIENT_CONTRACT in the app's
# utils/client-version.ts, raised by every release that changes what the app
# sends) still served: below it, 426 CLIENT_UPGRADE_REQUIRED, except sign-in,
# 2FA, refresh and logout. Empty = off. Only applies to builds that send
# x-trajetto-client-version; the web and older builds are never refused.
# MIN_MOBILE_CONTRACT=
# Optional, https only. The store page that 426 names as `storeUrl`, opened
# by the app when no over-the-air update fits its runtime. Empty = left out
# of the body (the app falls back to its own Play Store page).
# MOBILE_STORE_URL=

MASTER_USER_EMAIL=admin@example.com
MASTER_USER_INITIAL_PASSWORD=CHANGE_ME

# Meta WhatsApp Cloud API (official). In development use the test number from
# the Meta developer dashboard (WhatsApp > API Setup): it provides a temporary
# access token and a phone number id, and can message up to 5 verified numbers.
# Leave empty to run without WhatsApp — sends fail with a clear error.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# Pre-approved template used for every notification (single body variable).
META_WHATSAPP_TEMPLATE_NAME=trajetto_notification
META_WHATSAPP_API_VERSION=v23.0

# Separate approved template for a carrier's message to ITS customer (single
# body variable, no "Acesse o sistema"): a customer's spam report then risks
# this template only. Empty: those messages use META_WHATSAPP_TEMPLATE_NAME.
META_WHATSAPP_CUSTOMER_TEMPLATE_NAME=

# Numeric id of the WhatsApp Business Account (WABA) that owns the templates
# (Business Manager > WhatsApp accounts). Optional and not a secret: only the
# MASTER's provider readiness check (/health/providers) reads it, to say
# whether each template is APPROVED.
META_WHATSAPP_BUSINESS_ACCOUNT_ID=

# Meta status callbacks (POST /webhooks/whatsapp): the App Secret (App
# Dashboard > Settings > Basic) signs every callback, and the verify token is
# any string you also type in the dashboard's webhook setup. Leave empty to run
# without reconciliation: the receiver answers 404 and sends keep working.
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

RESEND_SECRET_KEY=
RESEND_FROM_EMAIL=
# Resend webhook signing secret (whsec_...) for POST /webhooks/resend, which
# records delivered/bounced/complained events. Empty: the receiver answers 404.
RESEND_WEBHOOK_SECRET=
# AI readings (receipt number/date, odometer) by the local OCR service
# trajetto-ai (docs/adr/0010; infra/ai-ocr). No external provider: the old
# ANTHROPIC_API_KEY / AI_ANTHROPIC_MODEL are gone, and AI_PROVIDER=anthropic
# now stops the boot. Start the service with
#   docker compose -f compose.development.yaml --profile ai up -d
# `none` switches the readings off; `local` without URL or token behaves the
# same. The token is the service's AI_TOKEN (32+ chars; this one is dev only,
# the same default as compose.development.yaml).
#
# Staging and production: trajetto-ai is its own Dokploy Application (no
# domain, internal port 8080), so the API Application's environment sets
#   AI_LOCAL_URL=http://<appName of the trajetto-ai Application>:8080
# (its service name on dokploy-network, shown in the panel) and
# AI_LOCAL_TOKEN (openssl rand -hex 32), the SAME value the trajetto-ai
# Application receives as AI_TOKEN. That Application also takes OCR_THREADS
# and AI_MAX_QUEUE (infra/ai-ocr/server.py); its CPU and memory limits are
# Swarm settings of that Application. Staging on the same host:
# AI_PROVIDER=none here and the AI Application stopped.
AI_PROVIDER=local
AI_LOCAL_URL=http://127.0.0.1:18080
AI_LOCAL_TOKEN=dev-only-token-0123456789abcdef0123
# One call's budget (must fit the 300 s lease) and reads in flight per replica.
# AI_LOCAL_TIMEOUT_MS=15000
# AI_LOCAL_MAX_CONCURRENCY=1

# Background workers (pipelines, webhook dispatcher, cron) on this process.
# `false` only on HTTP replicas that have a worker service of the same image
# running with `true` (docs/deploy.md (Réplicas, workers e tempo real)). The sweep is 30 s by default;
# a dedicated worker polls every 1-2 s.
# WORKERS_ENABLED=true
# PIPELINE_SWEEP_INTERVAL_MS=30000

# Production must use a private R2 bucket. Objects are returned through
# short-lived signed URLs; do not configure a public bucket/domain.
UPLOAD_STORAGE_TYPE=local
UPLOAD_LOCAL_PATH=./tmp
UPLOAD_SIGNED_URL_TTL_SECONDS=900
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Só para testes: um endpoint S3-compatível (o MinIO local do E2E de upload,
# tests/support/minio/minio-test.sh) no lugar do R2 da conta. Vazio em produção.
# R2_ENDPOINT=
# Coletor noturno de objetos do bucket que nenhuma linha referencia (só os de
# 30 a 33 dias). dry-run (padrão) só conta e registra no log; delete apaga;
# off desliga. Leia alguns resumos do dry-run antes de ligar o delete.
UPLOAD_ORPHAN_GC=dry-run
# Opcional. Apaga da trilha de auditoria (activity) o que tiver mais de N dias.
# Vazio = nunca apaga. Menos de 365 é recusado (a trilha é prova).
# ACTIVITY_RETENTION_DAYS=
# Dias em que o link público do comprovante (QR impresso, sem login) continua
# abrindo o PDF, contados da geração do documento. Depois responde 404, como um
# token que não existe. Padrão 1825 (5 anos, a guarda fiscal da NF-e).
PROOF_VERIFICATION_TTL_DAYS=1825
# Assinatura ICP-Brasil do comprovante (decisão 14.8). O certificado A1 (e-CNPJ)
# da plataforma, em PFX: base64 OU caminho de um arquivo montado como secret,
# nunca os dois. SEGREDOS: nunca no repositório nem em log. Sem eles, o PDF sai
# "sem assinatura digital" e diz isso. A razão social e o CNPJ impressos num
# documento assinado vêm do próprio certificado.
# Em staging/produção, cada variável deste bloco vai direto no Environment do
# Application da API no Dokploy; sem o certificado lá, os PDFs saem sem
# assinatura (e dizem isso).
# PROOF_SIGNING_PFX_BASE64=
# PROOF_SIGNING_PFX_PATH=/run/secrets/proof_signing.pfx
# PROOF_SIGNING_PFX_PASSWORD=
# pades-ad-rb (ICP-Brasil AD-RB v1.1, padrão) ou cms (o CMS simples do modelo).
# PROOF_SIGNATURE_PROFILE=pades-ad-rb
# true desliga a assinatura sem remover o certificado (incidente).
# PROOF_SIGNING_DISABLED=false
# PROOF_SIGNER_LOCATION=Rio de Janeiro, RJ
# PROOF_SIGNER_CONTACT=suporte@trajetto.com.br
# PROOF_SIGNER_BRAND=TRAJETTO
# Quem gerou um comprovante SEM assinatura. Sem CNPJ, o texto o omite.
# PROOF_ISSUER_LEGAL_NAME=Trajetto Sistemas Ltda
# PROOF_ISSUER_CNPJ=
# Mapa estático do comprovante: template XYZ {z}/{x}/{y} (https). Pode levar a
# chave do provedor (SEGREDO). O crédito é obrigatório com a URL. Em produção,
# tile.openstreetmap.org é recusado.
# PROOF_MAP_TILE_URL=
# PROOF_MAP_TILE_ATTRIBUTION=© OpenStreetMap
# PROOF_MAP_TIMEOUT_MS=3000
# Geocodificação reversa do GPS do comprovante (protocolo Nominatim). Vazio =
# desligada: o PDF imprime o endereço cadastrado, com rótulo. Em produção,
# nominatim.openstreetmap.org é recusado. A chave é SEGREDO.
# REVERSE_GEOCODER_URL=
# REVERSE_GEOCODER_KEY=
# REVERSE_GEOCODER_KEY_PARAM=key
# REVERSE_GEOCODER_USER_AGENT=
# REVERSE_GEOCODER_TIMEOUT_MS=2500
# The internal reference at /docs.
#
# Outside production it is open. In production it answers 404 unless BOTH of
# these are set, and then only behind HTTP Basic: /docs describes every
# endpoint of the product, including the ones only a master can call.
#
# The public integration reference is a different page and stays open:
# /integration/docs, built by subtraction and limited to what an API key
# reaches.
#
# DOCS_PASSWORD needs at least 20 characters; a shorter one keeps /docs closed
# (404) and the boot logs why.
DOCS_USER=
DOCS_PASSWORD=

# Cloudflare Turnstile no formulário público de orçamento, verificado pela
# PRÓPRIA API (o mesmo segredo do web). Com o segredo, pedido sem token é
# recusado (400 TURNSTILE_REQUIRED) e o token enviado é conferido na
# Cloudflare. Vazio: Turnstile desligado.
TURNSTILE_SECRET_KEY=

# De onde vem o endereço do cliente nas rotas ANÔNIMAS (login, 2FA,
# recuperação de senha). Decide o balde do rate limit dessas rotas.
#
#   none       -> só o socket. Correto SEM proxy nenhum na frente. Atrás de um,
#                 põe a internet toda num balde e o limite de login vira
#                 negação de serviço contra todo mundo.
#   xff        -> X-Forwarded-For, ÚLTIMA entrada (o par que o Traefik viu).
#                 Certo quando o Traefik/nginx É a borda. Atrás da Cloudflare
#                 o par é a borda dela, e todo mundo cai num balde só.
#   cloudflare -> CF-Connecting-IP, mas SÓ quando o par que o Traefik viu é da
#                 Cloudflare (faixas em src/config/trusted-edge.ts); fora
#                 disso vale o par, igual a `xff`. É o valor da produção.
#
# Fora de produção, ausente vale `none`. Em produção é OBRIGATÓRIA (o boot
# falha sem ela); atrás da Cloudflare, use `cloudflare`. Ver
# docs/deploy.md (Domínios, TLS e a borda).
RATE_LIMIT_TRUSTED_PROXY=none

# Opcional (mínimo 32 caracteres). Valor que uma Transform Rule das nossas
# zonas na Cloudflare põe no cabeçalho `x-trajetto-edge-secret`. Com ele, o
# modo `cloudflare` só acredita no CF-Connecting-IP que vem junto — um Worker
# de outra conta sai das mesmas faixas e não conhece o segredo.
# Gere com: openssl rand -hex 32
RATE_LIMIT_EDGE_SECRET=

# Segredo compartilhado com o servidor do Next.js (mínimo 32 caracteres; o
# mesmo valor vai no .env da web). Login, 2FA, recuperação de senha, refresh e
# rastreio público chegam pelo SERVIDOR da web, então sem isto todo usuário web
# conta como um endereço só para os limites dessas rotas.
# Gere com: openssl rand -hex 32
RATE_LIMIT_FORWARDER_SECRET=

# Opcional. Chave que cifra em repouso (AES-256-GCM) o segredo de assinatura e
# os cabeçalhos dos endpoints de webhook dos clientes. Base64 de 32 bytes.
# Vazia: fora de produção vale uma chave fixa de desenvolvimento; em produção
# os valores ficam em claro (o boot avisa). Guarde uma cópia FORA dos backups
# do banco: perdê-la torna ilegíveis os segredos cifrados.
# Gere com: openssl rand -base64 32
WEBHOOK_SECRETS_KEY=

# --- Processo (raramente mudam) -------------------------------------------
#
# Quanto o boot espera o Postgres responder antes de desistir (ms).
# WAIT_FOR_POSTGRES_TIMEOUT_MS=120000
# Threads do libuv (bcrypt, gzip, fs, dns). Definido no Dockerfile (8); só
# mude com medição.
# UV_THREADPOOL_SIZE=8
# Commit do build, que GET /health/liveness devolve em `version`/`commit`.
# Gravado na imagem pelo pipeline (build arg GIT_SHA); nunca defina à mão.
# Vazio = `dev`.
# APP_COMMIT_SHA=

# --- Só staging e produção (Environment do Application da API no Dokploy) --
# Em dev ficam vazias. Imagem (`:stable` em produção, `:staging` em staging),
# domínio, réplicas, limite de memória, healthcheck e ordem do update são
# campos do Application, não variáveis: docs/deploy.md.
#
# O teto de heap do Node acompanha o limite de memória do Application
# (~75% dele): com 1024M, NODE_OPTIONS=--max-old-space-size=768 aqui no
# Environment.
#
# MIGRATION_DATABASE_URL (o modelo está junto da DATABASE_URL, acima): URL sem
# os tetos de runtime para o `prisma migrate deploy` e os seeds da etapa de
# release (a imagem trajetto-api-migrate, que roda como job antes de cada
# deploy e copia o Environment da API). A API nunca migra no boot. Vazia = usa
# a DATABASE_URL. Ver docs/deploy.md (Migrations).
# `true` UMA vez, no primeiro boot de uma instalação nova: em produção o boot
# recusa um banco sem nenhuma migration aplicada (banco novo ou restaurado
# vazio). Ver docs/deploy.md (Backup e restauração).
# ALLOW_EMPTY_DATABASE_BOOTSTRAP=false
# Só para o ensaio de restore (infra/scripts/restore-postgres.sh): a imagem
# exata do Postgres do Dokploy (campo Docker Image do banco). Sem ela, a tag.
# POSTGRES_IMAGE=postgres:16-alpine
#
# Backup do banco: não tem variável. É o Backup do próprio Database do Dokploy
# (aba Backups do PostgreSQL, destino S3 no Cloudflare R2), configurado no
# painel. Ver docs/deploy.md (Backup e restauração).
