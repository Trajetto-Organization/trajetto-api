# Node.js (a pattern without **/ matches the context root only)
node_modules
**/node_modules
node_modules.bak/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment files - NEVER ship secrets in the image
.env
.env.*
!.env.example

# Local uploads
tmp/

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git
.git
.gitignore

# Docker
Dockerfile*
docker-compose*.yml
compose.yaml
compose.*.yaml

# Documentation, at any depth (`*.md` alone matched the root only): no
# image carries a `*.md` file or docs/, which is what lets a commit that
# changes only those be promoted with an earlier commit's build
# (.github/scripts/docs-only.sh, docs/deploy.md "Commits só de
# documentação").
**/*.md
docs/

# The trajetto-ai OCR service builds from its own context (infra/ai-ocr,
# ADR 0010). The API image never copies it, so its Python and the warm-up
# JPEG stay out of this build context.
infra/ai-ocr/

# Test files
tests/
test/
*.test.js
*.test.ts
*.spec.js
*.spec.ts
coverage/
.nyc_output/

# Logs
logs
**/*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Optional npm cache directory
.npm

# ESLint cache
.eslintcache

# Yarn Integrity file
.yarn-integrity

# Coverage directory used by tools like istanbul
coverage/

# Dependency directories
jspm_packages/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Local development files
api.http
setupTests.ts

# CI/CD
.github/
.gitlab-ci.yml

# What CI, the editor and the release read, and the build never does: out
# of the context, editing one no longer invalidates `COPY . .` and reruns
# `yarn build`. tsconfig.json and tsup.config.ts stay (tsup reads them).
.gitleaks.toml
.gitleaksignore
audit-ci.jsonc
.releaserc
.prettierrc
.prettierignore
.editorconfig
.gitattributes
stryker.config.mjs
vite.config.mts
vitest.mutation.config.mts

# Mutation testing (yarn test:mutation): Stryker's sandbox and reports
.stryker-tmp/
reports/

# The AI benchmark and the proof-asset generator, run by hand from the
# repository (their output, src/shared/services/proof-assets.generated.ts, is
# committed). infra/scripts is NOT this: the build compiles and copies it.
scripts/

# Terraform
*.tfstate
*.tfstate.*
*.tfvars
**/.terraform/*