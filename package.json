{
  "name": "trajetto-api",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "license": "UNLICENSED",
  "description": "Back-end do Trajetto (Node.js + Fastify + Prisma + PostgreSQL + Redis): API multiempresa dos módulos Frotas e Entregas, com tempo real (Socket.IO), filas no Postgres, crons, IA local de leitura de imagens, comprovante em PDF assinado e a API pública com webhooks. Atende o painel web (trajetto-ui), o app do motorista (trajetto-mobile) e as integrações dos clientes.",
  "scripts": {
    "dev": "run-s prisma:generate database:dev:up redis:dev:up wait-for-postgres prisma:migrate:deploy",
    "postdev": "run-s seed seed:infringement dev:server",
    "build": "tsup",
    "start": "sh -c \"test -f infra/scripts/docker-entrypoint.sh && exec sh infra/scripts/docker-entrypoint.sh || exec sh ./docker-entrypoint.sh\"",
    "migrate:release": "sh -c \"test -f infra/scripts/docker-entrypoint.sh && exec sh infra/scripts/docker-entrypoint.sh migrate || exec sh ./docker-entrypoint.sh migrate\"",
    "start:dev": "tsx src/server.ts",
    "dev:server": "tsx watch src/server.ts",
    "database:dev:up": "docker compose -f compose.development.yaml up -d trajetto-database",
    "database:dev:down": "docker compose -f compose.development.yaml down trajetto-database",
    "database:dev:stop": "docker compose -f compose.development.yaml stop trajetto-database",
    "redis:dev:up": "docker compose -f compose.development.yaml up -d trajetto-redis",
    "redis:dev:down": "docker compose -f compose.development.yaml down trajetto-redis",
    "redis:dev:stop": "docker compose -f compose.development.yaml stop trajetto-redis",
    "services:dev:up": "docker compose -f compose.development.yaml up -d",
    "services:dev:down": "docker compose -f compose.development.yaml down",
    "services:dev:stop": "docker compose -f compose.development.yaml stop",
    "wait-for-postgres": "tsx infra/scripts/wait-for-postgres.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev --create-only",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "seed": "tsx infra/scripts/seed.ts",
    "seed:infringement": "tsx infra/scripts/import-violation-codes.ts",
    "webhooks:seal": "tsx infra/scripts/seal-webhook-secrets.ts",
    "ci": "yarn install --frozen-lockfile",
    "test": "vitest run --dir tests/unitaires",
    "test:watch": "vitest --dir tests/unitaires",
    "test:e2e": "vitest run --dir ./tests/E2E",
    "test:e2e:watch": "vitest --dir ./tests/E2E",
    "test:coverage": "vitest run --dir tests/unitaires --coverage --coverage.thresholds.statements=70.8 --coverage.thresholds.lines=70.8 --coverage.thresholds.branches=82.57 --coverage.thresholds.functions=57.62",
    "test:coverage:e2e": "bash infra/scripts/coverage-e2e.sh",
    "test:mutation": "stryker run",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "validate": "run-s prisma:generate typecheck test",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1107.0",
    "@aws-sdk/s3-request-presigner": "3.1107.0",
    "@fastify/compress": "8.1.0",
    "@fastify/cors": "10.0.2",
    "@fastify/helmet": "13.0.1",
    "@fastify/rate-limit": "10.2.2",
    "@fastify/static": "8.3.0",
    "@fastify/swagger": "9.4.2",
    "@fastify/swagger-ui": "5.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@signpdf/placeholder-pdfkit": "3.3.0",
    "@signpdf/signpdf": "3.3.0",
    "@signpdf/utils": "3.3.0",
    "@socket.io/redis-adapter": "8.3.0",
    "bcrypt": "6.0.0",
    "dotenv": "16.4.7",
    "dotenv-expand": "12.0.1",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.0",
    "fastify": "5.2.0",
    "fastify-type-provider-zod": "4.0.2",
    "handlebars": "4.7.10",
    "ioredis": "5.10.1",
    "jsonwebtoken": "9.0.2",
    "node-cron": "4.2.1",
    "node-forge": "1.4.0",
    "nodemailer": "6.9.16",
    "pdfkit": "0.15.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prisma": "7.10.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "socket.io": "4.8.3",
    "tsyringe": "4.8.0",
    "undici": "7.29.0",
    "uuid": "11.0.5",
    "zod": "3.25.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "11.0.1",
    "@semantic-release/release-notes-generator": "14.0.3",
    "@stryker-mutator/core": "8.7.1",
    "@stryker-mutator/vitest-runner": "8.7.1",
    "@types/bcrypt": "5.0.2",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node-forge": "1.3.14",
    "@types/nodemailer": "6.4.17",
    "@types/pdfkit": "0.13.9",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "1.6.0",
    "@vitest/ui": "1.6.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "glob": "11.0.3",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.5.3",
    "semantic-release": "25.0.9",
    "socket.io-client": "4.8.1",
    "supertest": "7.0.0",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite-tsconfig-paths": "4.3.2",
    "vitest": "1.6.0",
    "vitest-environment-prisma": "file:./prisma/vitest-environment-prisma"
  }
}
