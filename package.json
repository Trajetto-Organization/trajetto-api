{
  "name": "trajetto-API",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "description": "Back-end do Trajetto (Node.js + Fastify + Prisma + PostgreSQL): API multi-tenant de gestão de frotas — veículos, motoristas, abastecimentos, checklists, ordens de serviço, peças, multas, contas a pagar, filiais e controle de acesso por perfil (MASTER, BUSINESS_ADMIN, BUSINESS_USER). Atende o trajetto-fleet-manager-ui e o aplicativo mobile.",
  "scripts": {
    "dev": "run-s database:dev:up redis:dev:up wait-for-postgres prisma:generate prisma:migrate:deploy",
    "postdev": "run-s seed seed:infringement dev:server",
    "build": "tsup",
    "start": "run-s prisma:generate prisma:migrate:deploy seed:production seed:infringement:production start:server",
    "start:dev": "tsx src/server.ts",
    "dev:server": "tsx watch src/server.ts",
    "start:server": "node build/server.js",
    "database:dev:up": "docker compose -f compose.development.yaml up -d trajetto-database",
    "database:dev:down": "docker compose -f compose.development.yaml down trajetto-database",
    "database:dev:stop": "docker compose -f compose.development.yaml stop trajetto-database",
    "redis:dev:up": "docker compose -f compose.development.yaml up -d trajetto-redis",
    "redis:dev:down": "docker compose -f compose.development.yaml down trajetto-redis",
    "redis:dev:stop": "docker compose -f compose.development.yaml stop trajetto-redis",
    "osrm:dev:up": "docker compose -f compose.osrm-development.yaml up -d trajetto-osrm",
    "osrm:dev:down": "docker compose -f compose.osrm-development.yaml down trajetto-osrm",
    "osrm:dev:stop": "docker compose -f compose.osrm-development.yaml stop trajetto-osrm",
    "services:dev:up": "docker compose -f compose.development.yaml up -d",
    "services:dev:down": "docker compose -f compose.development.yaml down",
    "services:dev:stop": "docker compose -f compose.development.yaml stop",
    "wait-for-postgres": "tsx infra/scripts/wait-for-postgres.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev --create-only",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "seed": "tsx infra/scripts/seed.ts",
    "seed:infringement": "tsx infra/scripts/import-violation-codes.ts",
    "r2:cors": "tsx infra/scripts/configure-r2-cors.ts",
    "seed:production": "node -e \"const { exec } = require('child_process'); if (process.env.NODE_ENV === 'production') { exec('node build/seed.js', (err, stdout, stderr) => { if (err) console.log('Seed já executado ou erro:', err.message); else console.log(stdout); }); } else { console.log('Seed pulado em desenvolvimento'); }\"",
    "seed:infringement:production": "node -e \"const { exec } = require('child_process'); if (process.env.NODE_ENV === 'production') { exec('node build/import-violation-codes.js', (err, stdout, stderr) => { if (err) console.log('Seed já executado ou erro:', err.message); else console.log(stdout); }); } else { console.log('Seed pulado em desenvolvimento'); }\"",
    "ci": "yarn install --frozen-lockfile",
    "test": "vitest run --dir tests/unitaires",
    "test:watch": "vitest --dir tests/unitaires",
    "test:e2e": "vitest run --dir ./tests/E2E",
    "test:e2e:watch": "vitest --dir ./tests/E2E",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "validate": "run-s prisma:generate typecheck test",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.78.0",
    "@aws-sdk/client-s3": "3.1107.0",
    "@aws-sdk/s3-request-presigner": "3.1107.0",
    "@fastify/compress": "8.1.0",
    "@fastify/cors": "10.0.2",
    "@fastify/helmet": "13.0.1",
    "@fastify/rate-limit": "10.2.2",
    "@fastify/swagger": "9.4.2",
    "@fastify/swagger-ui": "5.2.2",
    "@prisma/client": "6.1.0",
    "@socket.io/redis-adapter": "8.3.0",
    "bcrypt": "5.1.1",
    "dotenv": "16.4.7",
    "dotenv-expand": "12.0.1",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.0",
    "fastify": "5.2.0",
    "fastify-type-provider-zod": "4.0.2",
    "handlebars": "4.7.8",
    "ioredis": "5.10.1",
    "jsonwebtoken": "9.0.2",
    "node-cron": "4.2.1",
    "nodemailer": "6.9.16",
    "npm-run-all": "4.1.5",
    "prisma": "6.1.0",
    "reflect-metadata": "0.2.2",
    "socket.io": "4.8.1",
    "tsyringe": "4.8.0",
    "uuid": "11.0.5",
    "zod": "3.25.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "11.0.1",
    "@semantic-release/release-notes-generator": "14.0.3",
    "@types/bcrypt": "5.0.2",
    "@types/jsonwebtoken": "9.0.7",
    "@types/nodemailer": "6.4.17",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "1.6.0",
    "@vitest/ui": "1.6.0",
    "glob": "11.0.3",
    "prettier": "3.5.3",
    "semantic-release": "25.0.9",
    "supertest": "7.0.0",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite-tsconfig-paths": "4.3.2",
    "vitest": "1.6.0",
    "vitest-environment-prisma": "file:./prisma/vitest-environment-prisma"
  }
}
