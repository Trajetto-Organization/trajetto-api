{
  "name": "trajetto-API",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "run-s database:up && run-s rabbitmq:up && run-s wait-for-postgres && run-s evolution-api:up && run-s prisma:generate && run-s prisma:migrate:dev",
    "postdev": "run-s seed && run-s seed:infringement && run-s seed:whatsapp && tsx watch src/server.ts",
    "build": "tsup",
    "start": "run-s prisma:generate && run-s prisma:migrate:deploy && run-s seed:production && run-s seed:infringement:production && run-s seed:whatsapp:production && node build/server.js",
    "start:dev": "tsx src/server.ts",
    "database:up": "docker compose -f compose.development.yaml up -d trajetto-database",
    "database:down": "docker compose -f compose.development.yaml down trajetto-database",
    "database:stop": "docker compose -f compose.development.yaml stop trajetto-database",
    "rabbitmq:up": "docker compose -f compose.development.yaml up -d trajetto-rabbitmq",
    "rabbitmq:down": "docker compose -f compose.development.yaml down trajetto-rabbitmq",
    "rabbitmq:stop": "docker compose -f compose.development.yaml stop trajetto-rabbitmq",
    "osrm:up": "docker compose -f compose.osrm-development.yaml up -d trajetto-osrm",
    "osrm:down": "docker compose -f compose.osrm-development.yaml down trajetto-osrm",
    "osrm:stop": "docker compose -f compose.osrm-development.yaml stop trajetto-osrm",
    "evolution-api:up": "docker compose -f compose.evolution-api-development.yaml up -d",
    "evolution-api:down": "docker compose -f compose.evolution-api-development.yaml down",
    "evolution-api:stop": "docker compose -f compose.evolution-api-development.yaml stop",
    "application:up": "docker compose -f compose.development.yaml up -d trajetto-api",
    "application:down": "docker compose -f compose.development.yaml down trajetto-api",
    "application:stop": "docker compose -f compose.development.yaml stop trajetto-api",
    "services:up": "docker compose -f compose.development.yaml up -d",
    "services:down": "docker compose -f compose.development.yaml down",
    "services:stop": "docker compose -f compose.development.yaml stop",
    "wait-for-postgres": "tsx infra/scripts/wait-for-postgres.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "seed": "tsx infra/scripts/seed.ts",
    "seed:production": "node -e \"const { exec } = require('child_process'); if (process.env.NODE_ENV === 'production') { exec('node build/seed.js', (err, stdout, stderr) => { if (err) console.log('Seed já executado ou erro:', err.message); else console.log(stdout); }); } else { console.log('Seed pulado em desenvolvimento'); }\"",
    "seed:infringement": "tsx infra/scripts/import-violation-codes.ts",
    "seed:infringement:production": "node -e \"const { exec } = require('child_process'); if (process.env.NODE_ENV === 'production') { exec('node build/import-violation-codes.js', (err, stdout, stderr) => { if (err) console.log('Seed já executado ou erro:', err.message); else console.log(stdout); }); } else { console.log('Seed pulado em desenvolvimento'); }\"",
    "seed:whatsapp": "tsx infra/scripts/seed-whatsapp-instance.ts",
    "seed:whatsapp:production": "node -e \"const { exec } = require('child_process'); if (process.env.NODE_ENV === 'production') { exec('node build/seed-whatsapp-instance.js', (err, stdout, stderr) => { if (err) console.log('Seed whatsapp já executado ou erro:', err.message); else console.log(stdout); }); } else { console.log('Seed whatsapp pulado em desenvolvimento'); }\"",
    "ci": "yarn install --frozen-lockfile",
    "test": "vitest run --dir tests/unitaires",
    "test:watch": "vitest --dir tests/unitaires",
    "test:e2e": "vitest run --dir ./tests/E2E",
    "test:e2e:watch": "vitest --dir ./tests/E2E",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "docker:build": "docker build -t trajetto-api .",
    "docker:run": "docker run -p 3333:3333 --env-file .env.production trajetto-api",
    "docker:clean": "docker system prune -f && docker volume prune -f"
  },
  "dependencies": {
    "@fastify/compress": "8.1.0",
    "@fastify/cors": "10.0.2",
    "@fastify/helmet": "13.0.1",
    "@fastify/multipart": "9.2.1",
    "@fastify/rate-limit": "10.2.2",
    "@fastify/swagger": "9.4.2",
    "@fastify/swagger-ui": "5.2.2",
    "@prisma/client": "6.1.0",
    "amqplib": "0.10.5",
    "aws-sdk": "2.1692.0",
    "axios": "1.11.0",
    "bcrypt": "5.1.1",
    "date-fns": "4.1.0",
    "dotenv": "16.4.7",
    "dotenv-expand": "12.0.1",
    "fastify": "5.2.0",
    "fastify-type-provider-zod": "4.0.2",
    "glob": "11.0.3",
    "handlebars": "4.7.8",
    "jsonwebtoken": "9.0.2",
    "nodemailer": "6.9.16",
    "npm-run-all": "4.1.5",
    "prettier": "3.5.3",
    "pump": "3.0.3",
    "reflect-metadata": "0.2.2",
    "sharp": "0.34.3",
    "socket.io": "4.8.1",
    "tsyringe": "4.8.0",
    "uuid": "11.0.5",
    "xlsx": "0.18.5",
    "zod": "3.25.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "11.0.1",
    "@semantic-release/release-notes-generator": "14.0.3",
    "@types/amqplib": "0.10.7",
    "@types/bcrypt": "5.0.2",
    "@types/jsonwebtoken": "9.0.7",
    "@types/nodemailer": "6.4.17",
    "@types/pump": "1.1.3",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "1.6.0",
    "@vitest/ui": "1.6.0",
    "prisma": "6.1.0",
    "supertest": "7.0.0",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite-tsconfig-paths": "4.3.2",
    "vitest": "1.6.0",
    "vitest-environment-prisma": "file:./prisma/vitest-environment-prisma"
  }
}
