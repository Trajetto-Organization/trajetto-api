# The geocoding of the LocationIQ Startup plan, against the harness' fake
# geocoder (plano-escala LOAD-04, the import-geocode scene; decision D40).
#
# An env file of the API's own variables (and Node's trust of the fake's
# CA, NODE_EXTRA_CA_CERTS), which the replicas and the worker
# read only when the harness is started with
# LOAD_API_ENV_FILE=geocoder-startup.env and the `fakes` profile (the fake
# geocoder answers at https://fake-geocoder:8090). Without it, the harness
# has no geocoder, as before. Never a real provider: a load run must not
# spend an account's day, nor reach anything outside the machine.
#
#   LOAD_API_ENV_FILE=geocoder-startup.env docker compose --env-file .env \
#     -f tests/load/compose.load.yaml --profile fakes up -d --build
#
# The values are the Startup row of the D40 table in
# docs/variaveis-de-ambiente.md: 22 calls a second and 60 000 a day, of
# which the job takes 45 000, the panel's search 4 000 and the proof 5 000
# (90%); 17 a second shared and 2 reserved for the proof (19 of 22).
REVERSE_GEOCODER_URL=https://fake-geocoder:8090
# Production refuses a geocoder URL that is not https; the fake serves it
# with a CA of the run, written to the harness' fakes-ca volume. Node reads
# this once, at start: the replicas wait for the fake's healthcheck.
NODE_EXTRA_CA_CERTS=/fakes/ca.pem
LOCATIONIQ_RATE_PER_SECOND=22
LOCATIONIQ_DAILY_QUOTA=60000
GEOCODING_CALLS_PER_SECOND=17
GEOCODING_CALLS_PER_MINUTE=1020
GEOCODING_BACKGROUND_CALLS_PER_MINUTE=960
GEOCODING_PROOF_RESERVED_PER_SECOND=2
DELIVERY_GEOCODING_DAILY_BUDGET=45000
ADDRESS_SEARCH_DAILY_BUDGET=4000
PROOF_REVERSE_DAILY_BUDGET=5000
