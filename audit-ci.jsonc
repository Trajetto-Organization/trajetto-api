// Supply-chain gate (INFRA-16): audit-ci (a devDependency pinned in
// yarn.lock), run by .github/scripts/audit-gate.sh in ci.yml and deploy.yml,
// finds a CRITICAL advisory in a PRODUCTION dependency. It blocks only the
// push or PR that changes package.json, yarn.lock, a package-lock.json or
// this file (decision D1); on any other run the finding is a warning and a
// line in the job summary. An audit that could not reach the registry is
// tried again and never read as an advisory. Highs are Dependabot's job
// (security updates): gating on them today would leave the pipeline red for
// build-time tooling nothing ships.
//
// Each allowlist entry says why the advisory does not reach production and
// when to look again. Take it out as soon as the update lands.
{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  // yarn.lock is the lockfile. Explicit: auto-detection picks npm when a
  // stray package-lock.json is left on disk, and audits a different tree.
  "package-manager": "yarn",
  "critical": true,
  "skip-dev": true,
  "report-type": "important",
  // Empty since 30/10/2026: the last entry (tar via bcrypt 5 >
  // @mapbox/node-pre-gyp) went away with bcrypt 6, which has no node-pre-gyp.
  "allowlist": []
}
