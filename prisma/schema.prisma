// ── Deliveries module ────────────────────────────────────────────────────

// Delivery or pickup. The operation treats them as two kinds of the same
// record, not as two flows — same route, same driver, same proof.
enum DeliveryKind {
  DELIVERY
  PICKUP
}

enum RouteStatus {
  PLANNED // being assembled; the driver cannot see it
  RELEASED // handed to the driver, not yet departed
  IN_PROGRESS // the driver left
  COMPLETED // every stop resolved — reached on its own, never by a button
  CANCELLED // terminal
}

enum RouteStopStatus {
  PENDING
  ARRIVED
  COMPLETED
  FAILED
  CANCELLED
}

// A day's work for one driver in one vehicle: the entity the delivery module
// was missing. "Start route" used to be a verb — an updateMany moving every
// PENDING delivery of a driver to IN_TRANSIT — with nothing to consult,
// order, release, follow or close.
model Route {
  id String @id @default(uuid(7))

  // Sequential PER COMPANY, not globally. The id is already a UUID; this is
  // the number an operator says out loud and the proof document prints. A
  // global sequence would leak one carrier's volume to all the others — the
  // same enumeration leak the vehicle plate has today.
  code Int
  name String?

  status RouteStatus @default(PLANNED)

  // The operational day, kept apart from the execution timestamps: Tuesday's
  // route is planned on Monday and may leave late.
  scheduled_date DateTime

  planned_departure_at DateTime?
  planned_arrival_at   DateTime?

  started_at   DateTime?
  completed_at DateTime?

  // Required to cancel a route that already left, so the trail says why.
  cancellation_reason String?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  driver   Driver @relation(fields: [driverId], references: [id])
  driverId String

  // Optional while planning, required to release — see canReleaseRoute.
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleId String?

  stops  RouteStop[]
  events DeliveryEvent[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([businessId, code])
  // Serves the panel: routes of a company by status and day.
  @@index([businessId, status, scheduled_date])
  // Serves the app: the released or running route of one driver.
  @@index([businessId, driverId, status])
  // A vehicle may be in at most ONE route in progress — the truck is on one
  // road. Enforced as a partial unique index in raw SQL (Prisma cannot
  // express the WHERE), see the migration. Declared here only as a comment so
  // nobody expects to find it in this file.
  @@map("route")
}

// One delivery inside one route, in a chosen position.
model RouteStop {
  id String @id @default(uuid(7))

  // Manual order, set by dragging. Spaced by ten on insert so dropping a stop
  // between two others does not rewrite every row after it.
  sequence Int

  // The stop carries its own outcome rather than reading the delivery's,
  // because the same delivery can appear in more than one route over time.
  status RouteStopStatus @default(PENDING)

  arrived_at   DateTime?
  completed_at DateTime?

  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId String

  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryId String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([routeId, sequence])
  @@index([routeId, status])
  // A delivery may have at most ONE open stop across all routes. Also a
  // partial unique index in raw SQL — see the migration.
  @@index([deliveryId])
  @@map("route_stop")
}

enum DeliveryStatus {
  PENDING // created (manually or imported), not yet on route
  IN_TRANSIT // out with a driver
  DELIVERED // completed with proof of delivery
  FAILED // blocking occurrence — awaiting a redelivery decision
  CANCELLED // cancelled by management (terminal)
}

// Shipper = embarcador: the cargo owner a carrier delivers for. It is a
// dimension INSIDE the tenant (a carrier serves many shippers), never a
// second tenant — the delivery module is multi-shipper by design.
model Shipper {
  id String @id @default(uuid(7))

  name      String
  cnpj      String?
  email     String?
  telephone String?
  is_active Boolean @default(true)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  deliveries Delivery[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([businessId, name])
  @@index([businessId])
  @@map("shipper")
}

// Per-company occurrence catalog (Comprovei-style): the company defines its
// own vocabulary; blocking types flip the delivery to FAILED when reported.
model OccurrenceType {
  id String @id @default(uuid(7))

  name            String
  description     String?
  requires_photo  Boolean @default(false)
  blocks_delivery Boolean @default(false)
  is_active       Boolean @default(true)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  occurrences DeliveryOccurrence[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([businessId, name])
  @@index([businessId])
  @@map("occurrence_type")
}

model Delivery {
  id String @id @default(uuid(7))

  // Client-facing reference (order number) and the NFe backing the cargo.
  // invoice_key (44-digit access key) is the dedupe anchor for XML import.
  code           String?
  invoice_key    String?
  invoice_number String?

  recipient_name      String
  recipient_document  String?
  recipient_email     String?
  recipient_telephone String?

  cep            String?
  city           String
  uf             String
  street         String
  address_number String?
  complement     String?
  neighborhood   String?

  status         DeliveryStatus @default(PENDING)
  scheduled_date DateTime?
  delivered_at   DateTime?
  received_by    String? // who signed at the door

  notes String?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  shipper   Shipper @relation(fields: [shipperId], references: [id])
  shipperId String

  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleId String?

  driver   Driver? @relation(fields: [driverId], references: [id])
  driverId String?

  // Delivery or pickup. Two kinds of the same record, not two flows: the
  // operation treats them alike and every endpoint, filter and card built
  // without this field would have to be revisited later. Cheap now.
  kind DeliveryKind @default(DELIVERY)

  items        DeliveryItem[]
  occurrences  DeliveryOccurrence[]
  events       DeliveryEvent[]
  chatMessages ChatMessage[]

  // N:N with Route on purpose. A failed delivery re-enters on the NEXT day's
  // route as a new stop, and the previous stop stays exactly as it was — that
  // record is what answers "what happened to invoice X".
  stops RouteStop[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([businessId, invoice_key])
  // The default listing carries no status filter, so it needs businessId
  // leading and created_at behind it — otherwise every page is a top-N sort
  // over the tenant's whole history, and the paired count() sorts it again.
  @@index([businessId, created_at])
  // Superset of the old ([businessId, status]) at the same write cost: serves
  // the filtered listing AND countDeliveriesByStatus AND operationSummary,
  // now without the sort.
  @@index([businessId, status, created_at])
  // ([businessId, scheduled_date]) removed: scheduled_date appears in no
  // `where` anywhere in the codebase — only in an orderBy whose `where` is
  // (businessId, driverId, status), which that index cannot serve. It was a
  // dead index on the most-written table in the system.
  @@index([shipperId])
  // Kept on purpose despite looking redundant: every driver query is
  // (businessId, driverId, status), and driverId is far more selective than
  // businessId.
  @@index([driverId])
  @@map("delivery")
}

model DeliveryItem {
  id String @id @default(uuid(7))

  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 3)
  unit        String?
  unit_value  Decimal? @db.Decimal(10, 2)

  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryId String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([deliveryId])
  @@map("delivery_item")
}

model DeliveryOccurrence {
  id String @id @default(uuid(7))

  description String?
  latitude    Float?
  longitude   Float?
  photos      String[] // storage paths — populated by the driver app slice

  // Outbox idempotency anchor: the driver app may resend after a dead
  // network; the same submission never becomes two occurrences.
  client_submission_id String? @unique

  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryId String

  occurrenceType   OccurrenceType @relation(fields: [occurrenceTypeId], references: [id])
  occurrenceTypeId String

  reportedBy   User   @relation(fields: [reportedById], references: [id])
  reportedById String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([deliveryId])
  @@map("delivery_occurrence")
}

// A driver appointment on a delivery: arriving at the address, proving the
// drop-off. Events, not columns on Delivery, because a redelivery attempt
// (FAILED -> PENDING -> IN_TRANSIT) legitimately produces a second arrival
// and the trail must keep both.
enum DeliveryEventType {
  ARRIVAL
  PROOF
}

model DeliveryEvent {
  id String @id @default(uuid(7))

  type DeliveryEventType

  latitude  Float?
  longitude Float?

  // Storage keys validated against the bucket before they become rows.
  photo     String? // delivery receipt ("canhoto") — PROOF only
  signature String? // on-screen signature image — PROOF only

  received_by String?

  // Outbox idempotency anchor: the driver app may resend after a dead
  // network; the same submission never becomes two events.
  client_submission_id String? @unique

  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryId String

  // Which route this happened on, so support can answer "on which route" and
  // not only "on which delivery". SetNull rather than Cascade: the event IS
  // the record, and has to outlive anything that might remove the route.
  route   Route?  @relation(fields: [routeId], references: [id], onDelete: SetNull)
  routeId String?

  reportedBy   User   @relation(fields: [reportedById], references: [id])
  reportedById String

  created_at DateTime @default(now())

  @@index([deliveryId])
  @@map("delivery_event")
}

// ============================================================================
// Chat SAC × driver (Deliveries module, slice 6)
//
// One thread per driver per business: the dispatcher talks to the person,
// not to a delivery — a message references a delivery as optional context.
// Reads are per-user cursors, never per-message receipts: WhatsApp-style
// checks and unread counts are DERIVED by comparing cursors against
// created_at, which stays correct under horizontal scale by construction
// (no counter to increment, nothing to reconcile between replicas).

model ChatThread {
  id String @id @default(uuid(7))

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId String

  // Ordering key for the SAC's thread list, kept in the same transaction
  // that inserts a message — it can never drift from the messages.
  last_message_at DateTime?

  // Delivery cursors: everything created up to each instant is already on a
  // real device of that side. They live on the thread because a thread has
  // exactly one driver and one SAC team, so neither can denormalize.
  //
  // The staff side is a team, not a person: the cursor is the most advanced
  // confirmation from ANY agent's open panel, which is what "the base has
  // it" means to a driver. A MASTER never advances it — the vendor holding
  // a message is not the customer's operation holding it.
  driver_delivered_at DateTime?
  staff_delivered_at  DateTime?

  messages ChatMessage[]
  reads    ChatThreadRead[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([businessId, driverId])
  @@index([businessId, last_message_at])
  @@map("chat_thread")
}

enum ChatMessageKind {
  TEXT
  IMAGE
  AUDIO
}

// A message is an immutable operational record (who told the driver to move
// on stays on file) — there is no edit or delete, removal only cascades with
// the tenant.
model ChatMessage {
  id String @id @default(uuid(7))

  kind ChatMessageKind

  // The text, or the caption under an attachment.
  body String?

  // Storage key for IMAGE/AUDIO — validated against bucket and tenant
  // before it becomes a row, signed on read (presigned-PUT pattern).
  attachment_key String?

  // Audio length so the player can render before the file loads.
  duration_ms Int?

  // Optional context chip: "this message is about that delivery".
  delivery   Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  deliveryId String?

  // The same text fanned out to several drivers shares one broadcast id,
  // so the UI can label it as a mass notice.
  broadcast_id String?

  // Retry idempotency anchor: the send button may fire again after a dead
  // network; the same submission never becomes two messages.
  client_submission_id String? @unique

  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId String

  sender   User   @relation(fields: [senderId], references: [id])
  senderId String

  created_at DateTime @default(now())

  // Wider than it looks like it needs to be, on purpose. The ordered prefix
  // (threadId, created_at) still serves history pagination; the trailing
  // senderId is what lets the unread count filter inside the index instead of
  // scanning the whole table. One index doing both is 141 MB where two were
  // 287 — see the 20260910120000_chat_scale_indexes migration for the numbers.
  //
  // That migration also creates a GIN trigram index on `body` for the message
  // search, which Prisma has no syntax for: `migrate dev` will offer to drop
  // it. Say no.
  @@index([threadId, created_at, senderId])
  @@map("chat_message")
}

// One read cursor per participant per thread. The SAC side is a team: each
// agent keeps their own cursor, and "read by the company" is the most
// advanced one.
model ChatThreadRead {
  id String @id @default(uuid(7))

  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  last_read_at DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([threadId, userId])
  @@map("chat_thread_read")
}
