  photos_by_field   Json? // Explicit field-to-photo mapping: { fieldName: [path1, path2] }
  overall_condition String // "approved", "approved_with_restrictions", "rejected"

  // AI Verification results
  ai_verification_status  String    @default("pending") // pending, analyzing, verified, issues_found, error, skipped
  ai_verification_details Json? // Per-field AI analysis: { fieldName: { status, confidence, observation } }
  ai_verified_at          DateTime? // When AI analysis was completed

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

