generator client {
  provider = "prisma-client-js"

  // Without `binaryTargets`, Prisma downloads the engine for multiple targets "just
  // in case," and each one adds significant size to the image. Here, we pin the two
  // we actually use: `native` for the development machine and
  // `linux-musl-openssl-3.0.x` for the container (`node:22-alpine` uses musl).
  // If you change the Dockerfile base image, make sure to update this line as well.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]

  // `metrics` adds `$metrics.json()`: the connection pool's open/busy/idle
  // gauges and the wait for a free connection, per replica. Without it the
  // pool, which is what saturates first under load (the ADR 0001 and 0004
  // triggers are written in terms of it), cannot be observed at all.
  previewFeatures = ["metrics"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MASTER
  BUSINESS_ADMIN
  BUSINESS_USER
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  IN_ROUTE
}

enum QuoteStatus {
  PENDING
  CONTACTED
  CLOSED
  CONVERTED
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

enum ContractType {
  OWNED
  THIRD_PARTY
}

// CNH classes (CTB art. 143), the combined ones included: a driver licensed
// for a truck and a motorcycle holds "AC", not two classes.
enum CnhCategory {
  A
  B
  C
  D
  E
  AB
  AC
  AD
  AE
}

enum FleetType {
  OWNED
  THIRD_PARTY
}

enum MaintenanceType {
  INTERNAL
  EXTERNAL
}

enum ViolationGravity {
  LIGHT // Light (3 points)
  MEDIUM // Average (4 points)
  SERIOUS // Serious (5 points)
  VERY_SERIOUS // Very serious (7 points)
  NO_POINTS // No punctuation
}

enum LocationSource {
  GPS_AUTO // GPS captured automatically (not edited)
  GPS_MANUAL // GPS captured + manual adjustment (driver corrected it)
  USER_MANUAL // Added manually by user (web dashboard)
  NONE // No location
}

enum RecordOrigin {
  MOBILE_APP // Created via mobile app
  WEB_DASHBOARD // Created via web dashboard
}

model Business {
  id               String  @id @default(uuid(7))
  corporate_reason String  @unique
  fantasy_name     String?
  cep              String
  city             String
  uf               String
  street           String
  address_number   String
  cnpj             String  @unique
  complement       String?
  cnae             String
  erp_code         String? @unique
  responsible_name String
  telephone        String
  email            String  @unique
  is_active        Boolean @default(true)

  /// IANA zone of the carrier's operation: what "today", "the last N days",
  /// the AI quota month and every daily bucket mean for this company. Brazil
  /// has four zones and there are carriers in MT, MS, RO, AM, AC and RR, so a
  /// fixed zone would get their day wrong. The container stays in UTC on
  /// purpose — see src/shared/time/business-day.ts.
  timezone String @default("America/Sao_Paulo")

  users User[]

  ProfileAccess ProfileAccess[]
  Permission    Permission[]

  vehicleTypes      VehicleType[]
  vehicles          Vehicle[]
  drivers           Driver[]
  parts             Part[]
  fuelTypes         FuelType[]
  serviceOrders     ServiceOrder[]
  serviceOrderParts ServiceOrderPart[]
  accountsPayable   AccountPayable[]

  branches  Branch[]
  suppliers Supplier[]

  Activity     Activity[]
  Notification Notification[]

  chatThreads    ChatThread[]
  supportTickets SupportTicket[]

  // Monthly AI analysis quota (managed by master; 0 = disabled). Consumption
  // lives in AIUsagePeriod — one ledger row per month, nothing is ever reset.
  ai_analysis_limit Int @default(0)

  // Contracted fleet size (managed by master; 0 = not configured). Billing
  // baseline per vehicle — becomes the enforcement input when entitlements
  // land; until then it is registration data only.
  vehicle_limit Int @default(0)

  // The legacy AI quota counter, replaced by AIUsagePeriod. It stays in the
  // database for ONE release: the previous image (N-1) still selects and
  // increments it, and runs against this schema during a start-first deploy
  // and after an automatic rollback. @ignore keeps it out of this client, so
  // nothing here can read or write it. Dropped in the contract phase — see
  // migrations/20260924090000_keep_legacy_columns_for_rollback.
  ai_analysis_used     Int      @default(0) @ignore
  ai_analysis_reset_at DateTime @default(now()) @ignore

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  KanbanColumn     KanbanColumn[]
  Fine             Fine[]
  Fuel             Fuel[]
  VehicleChecklist VehicleChecklist[]

  entitlements BusinessEntitlement[]

  shippers            Shipper[]
  routes              Route[]
  occurrenceTypes     OccurrenceType[]
  statusChangeReasons StatusChangeReason[]
  imports             Import[]
  deliveries          Delivery[]

  externalRecipients     ExternalRecipient[]
  deliveryProofDocuments DeliveryProofDocument[]
  deliveryProofAudits    DeliveryProofAudit[]

  apiKeys                  ApiKey[]
  apiKeyUsage              ApiKeyUsageDaily[]
  driverPositions          DriverLastPosition[]
  webhookEndpoints         WebhookEndpoint[]
  webhookDeliveries        WebhookDelivery[]
  deliveryMessageTemplates DeliveryMessageTemplate[]

  driverPauses DriverPause[]

  @@map("business")
}

enum BusinessModule {
  FLEET
  DELIVERIES
}

// Sellable modules per company — the on/off of access. A missing row means
// the module was never hired (the migration seeds FLEET for every existing
// business: the product they already bought). Numeric limits (vehicles, AI)
// stay as Business columns; this table only answers "does this company have
// this module?" for API middleware and front-end navigation.
model BusinessEntitlement {
  id         String         @id @default(uuid(7))
  businessId String
  module     BusinessModule
  enabled    Boolean        @default(true)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([businessId, module])
  @@map("business_entitlement")
}

model User {
  id             String    @id @default(uuid(7))
  name           String
  email          String    @unique
  email_verified DateTime? @map("email_verified")
  password       String
  avatar         String?
  role           UserRole

  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String?

  profileAccess   ProfileAccess? @relation(fields: [profileAccessId], references: [id])
  profileAccessId String?

  driver   Driver? @relation(fields: [driverId], references: [id])
  driverId String? @unique

  RefreshToken RefreshToken[]

  serviceOrders          ServiceOrder[] // Responsible user
  accountsPayable        AccountPayable[] @relation("AccountPayableResponsible")
  accountsPayableCreated AccountPayable[] @relation("AccountPayableCreatedBy")
  Notification           Notification[]
  Activity               Activity[]

  two_factor_enabled Boolean @default(false)
  access_revoked     Boolean @default(false)
  session_version    Int     @default(0)

  /// Per-account brake on password guessing. In Postgres on purpose: the IP
  /// rate limit lives in Redis and fails open (ADR 0002), so without this a
  /// Redis outage leaves the login with no bound at all. Failures inside a
  /// window are counted; enough of them lock the account for a while.
  failed_login_attempts Int       @default(0)
  failed_login_at       DateTime?
  login_locked_until    DateTime?

  TwoFactorConfirmation  TwoFactorConfirmation?
  KanbanCard             KanbanCard[]
  PendingDeletion        PendingDeletion[]
  NotificationDelivery   NotificationDelivery[]
  NotificationPreference NotificationPreference[]
  PushDeviceToken        PushDeviceToken[]
  Import                 Import[]
  proofAudits            DeliveryProofAudit[]

  // WhatsApp fields
  whatsapp_notifications_enabled Boolean @default(false)
  whatsapp_phone                 String?

  // The per-user state of the retired WhatsApp gateway. Kept one release for
  // the N-1 image and ignored by this client, exactly like
  // Business.ai_analysis_used.
  whatsapp_instance_connected Boolean @default(false) @ignore

  email_notifications_enabled    Boolean @default(true)
  activity_notifications_enabled Boolean @default(true)

  deliveryOccurrences   DeliveryOccurrence[] @relation("OccurrenceReportedBy")
  authorizedOccurrences DeliveryOccurrence[] @relation("OccurrenceAuthorizedBy")
  deliveryEvents        DeliveryEvent[]

  chatMessages    ChatMessage[]
  chatThreadReads ChatThreadRead[]

  /// Decision 14.6: the web's operations alert plays a sound. Per person and
  /// server-side so it follows them across browsers; the balloon itself is
  /// always shown, only the sound is optional.
  ops_alert_sound_enabled Boolean @default(true)

  openedSupportTickets   SupportTicket[]      @relation("SupportTicketOpenedBy")
  assignedSupportTickets SupportTicket[]      @relation("SupportTicketAssignee")
  closedSupportTickets   SupportTicket[]      @relation("SupportTicketClosedBy")
  supportTicketEvents    SupportTicketEvent[] @relation("SupportTicketEventActor")
  supportTicketReads     SupportTicketRead[]

  // Stamped when the user's last socket disconnects — the "visto por
  // último" the SAC sees next to a driver's name in the chat.
  last_seen_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // There was no tenant index at all here, so this was a sequential scan.
  // listUsers, and findUsersByBusiness, which the notification pipeline calls to expand recipients on EVERY domain event.
  @@index([businessId, created_at])
  // Serves the ON DELETE SET NULL when an access profile is deleted.
  @@index([profileAccessId])
  @@map("user")
}

model ProfileAccess {
  id   String @id @default(uuid(7))
  name String // Profile name (e.g. "Manager", "Analyst")

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String // Relates the profile to a company

  permissions Permission[] // Relationship to specific permissions
  users       User[] // Users who have this profile

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([name, businessId]) // 🔒 Ensure unique names per company
  // The unique above leads with `name`; the tenant's profiles (and the
  // cascade when a business is deleted) are looked up by businessId.
  @@index([businessId])
  @@map("profile_access")
}

model Permission {
  id     String @id @default(uuid(7))
  action String // Permission name (e.g. "Manage Users")

  permissionKey String @default("")

  canRead  Boolean @default(false) // Read permission
  canWrite Boolean @default(false) // Write permission

  profileAccess   ProfileAccess @relation(fields: [profileAccessId], references: [id], onDelete: Cascade)
  profileAccessId String

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([action, profileAccessId, businessId]) // Prevents duplication of permissions on the same profile and company
  // Every authenticated request loads a profile's permissions by profile; the
  // unique above leads with `action` and cannot serve that.
  @@index([profileAccessId])
  // The cascade when a business is deleted.
  @@index([businessId])
  @@map("permission")
}

model RefreshToken {
  id              String    @id @default(uuid(7))
  token_hash      String    @unique
  jti             String    @unique
  family_id       String
  expires_in      DateTime
  revoked_at      DateTime?
  replaced_by_jti String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String

  created_at DateTime @default(now())

  @@index([userId, family_id])
  @@index([family_id, revoked_at])
  @@index([expires_in])
  @@map("refresh_token")
}

model ForgotPasswordVerificationToken {
  id      String   @id @default(uuid(7))
  email   String   @unique
  /// The SHA-256 (hex) of the token mailed to the user, never the token
  /// itself — the same rule as refresh_token.token_hash: reading this table
  /// must not be enough to reset somebody's password. The column keeps its
  /// name; a row written before the change holds a raw token, which no
  /// lookup by hash can match, and expires within the hour.
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@map("forgot_password_verification_token")
}

model EmailVerificationToken {
  id      String   @id @default(uuid(7))
  email   String   @unique
  /// The SHA-256 (hex) of the token in the verification link, never the
  /// token itself. See ForgotPasswordVerificationToken.token.
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@map("email_verification_token")
}

model TwoFactorConfirmation {
  id     String @id @default(uuid(7))
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId])
  @@map("two_factor_confirmation")
}

model TwoFactorToken {
  id      String   @id @default(uuid(7))
  email   String   @unique
  token   String   @unique
  expires DateTime

  /// Quantos palpites errados este código já levou.
  ///
  /// O código tem seis dígitos e vale quinze minutos. Sem contador, um palpite
  /// errado não consumia nada e não contava para nada — a única barreira era o
  /// rate limit, e ele era contornável pelo cabeçalho que o cliente escreve.
  /// Com contador, o espaço de busca deixa de ser um milhão de tentativas e
  /// passa a ser um punhado por código.
  attempts Int @default(0)

  @@unique([email, token])
  @@map("two_factor_token")
}

model PendingDeletion {
  id          String   @id @default(uuid(7))
  entity_type String // 'branch' | 'business'
  entity_id   String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  code_hash   String
  expires     DateTime
  created_at  DateTime @default(now())

  @@unique([entity_type, entity_id, userId])
  @@index([userId])
  @@index([expires])
  @@map("pending_deletion")
}

model Branch {
  id               String  @id @default(uuid(7))
  // Unique per company (see @@unique below), like email and erp_code: a
  // platform-wide unique let one carrier block another's registration and
  // told it the other existed (decision 8.1). The CNPJ stays global — it is
  // the national identity of the branch.
  corporate_reason String
  fantasy_name     String?
  cep              String
  city             String
  uf               String
  street           String
  address_number   String
  cnpj             String  @unique
  complement       String?
  cnae             String
  // Unique per company (see @@unique below), not across the platform: it is
  // the code of the branch in THIS carrier's ERP, and two carriers numbering
  // their branches "001" is the normal case — see
  // docs/arquitetura.md (Unicidade por empresa).
  erp_code         String?
  responsible_name String
  telephone        String
  email            String
  is_active        Boolean @default(true)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  vehicles        Vehicle[]
  drivers         Driver[]
  serviceOrders   ServiceOrder[]
  accountsPayable AccountPayable[]

  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  Fine             Fine[]
  Fuel             Fuel[]
  VehicleChecklist VehicleChecklist[]

  @@unique([businessId, erp_code])
  @@unique([businessId, corporate_reason])
  @@unique([businessId, email])
  // There was no tenant index at all here, so this was a sequential scan.
  // listAllBranches; small per tenant, but read by nearly every form.
  @@index([businessId, created_at])
  @@map("branch")
}

model Supplier {
  id             String  @id @default(uuid(7))
  name           String
  cnpj           String
  cep            String?
  city           String?
  uf             String?
  street         String?
  address_number String?
  complement     String?
  telephone      String?
  email          String?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  parts           Part[]
  serviceOrders   ServiceOrder[]
  accountsPayable AccountPayable[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // No unique in the database: duplicates are refused by the use cases, so
  // decision 8.1 has nothing to relax here (it applies to those checks).
  //
  // There was no tenant index at all here: the listing (by tenant, newest
  // first) and the cascade from a deleted business were sequential scans.
  @@index([businessId, created_at])
  @@map("supplier")
}

model VehicleType {
  id              String @id @default(uuid(7))
  description     String
  number_of_axles Int

  /// The licence a driver needs for this kind of vehicle. Null = not
  /// configured, and assigning then checks nothing. A warning, never a block
  /// (decision 8.5).
  required_cnh_category CnhCategory?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  vehicles Vehicle[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Same as supplier: the tenant listing had no index to start from.
  @@index([businessId, created_at])
  @@map("vehicle_type")
}

model FuelType {
  id          String @id @default(uuid(7))
  description String

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  vehicles Vehicle[]
  fuels    Fuel[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Same as supplier: the tenant listing had no index to start from.
  @@index([businessId, created_at])
  @@map("fuel_type")
}

model Driver {
  id         String   @id @default(uuid(7))
  name       String
  birth_date DateTime
  // CNH and CPF are unique per company (see @@unique below), not across the
  // platform: Driver is the person as hired by THIS carrier, and an
  // independent driver can work for two (decision 8.1).
  cnh        String
  cpf        String

  /// The licence class and its expiry, for the assignment warnings
  /// (decision 8.5). Optional: legacy rows predate them. The expiry is a
  /// civil date, stored as `date`.
  cnh_category   CnhCategory?
  cnh_expires_at DateTime?    @db.Date

  // Not unique: an RG is issued per state, so the same number legitimately
  // belongs to two people — and a platform-wide unique let one carrier
  // block another's registration. See docs/arquitetura.md (Unicidade por empresa).
  rg             String
  cep            String
  city           String
  uf             String
  street         String
  address_number String
  complement     String?
  status         DriverStatus
  contract_type  ContractType

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  branch   Branch? @relation(fields: [branchId], references: [id])
  branchId String?

  vehicles Vehicle[]
  User     User?

  Fine             Fine[]
  Fuel             Fuel[]
  VehicleChecklist VehicleChecklist[]
  deliveries       Delivery[]
  routes           Route[]
  chatThreads      ChatThread[]
  pauses           DriverPause[]

  created_at   DateTime            @default(now())
  updated_at   DateTime            @updatedAt
  lastPosition DriverLastPosition?

  @@unique([businessId, cnh])
  @@unique([businessId, cpf])
  // There was no tenant index at all here, so this was a sequential scan.
  // listDrivers and the driver picker used by delivery, fine, fuel, checklist and chat.
  @@index([businessId, created_at])
  // ON DELETE SET NULL when a branch is deleted.
  @@index([branchId])
  @@map("driver")
}

model Vehicle {
  id                          String        @id @default(uuid(7))
  description                 String
  // Plate and RENAVAM are unique per company (see @@unique below): Vehicle is
  // the truck in THIS carrier's operation, and an aggregated (third-party)
  // truck can serve two carriers (decision 8.1).
  license_plate               String
  brand                       String
  model                       String
  acquisition_date            DateTime
  fleet_type                  FleetType
  fleet_id                    String?
  last_maintenance_date       DateTime?
  current_mileage             Float
  last_maintenance_mileage    Float?
  maintenance_interval_km     Float
  maintenance_interval_months Int
  renavam                     String
  manufacturing_year          DateTime
  model_year                  DateTime
  // Fractional (trucks do 2.5-4 km/l; decision 8.6). A Float like the other
  // measurements of this model, not a Decimal: a Decimal reaches the client
  // as a string and fails the number the GET response schema declares.
  km_per_liter                Float
  number_of_axles             Int
  status                      VehicleStatus

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  vehicleType   VehicleType? @relation(fields: [vehicleTypeId], references: [id])
  vehicleTypeId String?

  fuelType   FuelType @relation(fields: [fuelTypeId], references: [id])
  fuelTypeId String

  driver   Driver? @relation(fields: [driverId], references: [id])
  driverId String?

  branch   Branch? @relation(fields: [branchId], references: [id])
  branchId String?

  serviceOrders ServiceOrder[]

  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  Fine             Fine[]
  Fuel             Fuel[]
  VehicleChecklist VehicleChecklist[]
  deliveries       Delivery[]
  routes           Route[]
  accountsPayable  AccountPayable[]

  @@unique([businessId, license_plate])
  @@unique([businessId, renavam])
  // There was no tenant index at all here, so this was a sequential scan.
  // listVehicles plus four dashboard counts — the most frequent query in the app.
  @@index([businessId, created_at])
  // One per foreign key: each is what Postgres reads when the referenced row
  // is deleted (SET NULL or RESTRICT), and what the "is it still used?"
  // checks before a delete read. Without them, every such delete is a scan.
  @@index([branchId])
  @@index([driverId])
  @@index([fuelTypeId])
  @@index([vehicleTypeId])
  @@map("vehicle")
}

model Part {
  id          String  @id @default(uuid(7))
  description String
  unit_price  Decimal @db.Decimal(10, 2)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?

  serviceOrderParts ServiceOrderPart[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // There was no tenant index at all here: the listing (by tenant, newest
  // first) and the cascade from a deleted business were sequential scans.
  @@index([businessId, created_at])
  // ON DELETE SET NULL when a supplier is deleted.
  @@index([supplierId])
  @@map("part")
}

model ServiceOrder {
  id               String          @id @default(uuid(7))
  date             DateTime        @default(now())
  completion_date  DateTime?
  maintenance_type MaintenanceType
  total_amount     Decimal         @db.Decimal(10, 2)

  // Free text: what this service order is about. Nullable because legacy
  // rows predate the field.
  description String?

  // 📸 SNAPSHOT: Vehicle data at the time of OS creation
  current_mileage_at_service          Float? // Current mileage when creating the OS
  maintenance_interval_km_at_service  Float? // Vehicle service interval when the OS was created
  last_maintenance_mileage_at_service Float? // Last vehicle review when the OS was created

  // 🔧 NEW MILEAGE: Reported by mechanic upon completion
  new_mileage_after_service Float? // New mileage after service

  // 📍 GEOLOCATION: Final location (edited or original)
  latitude  Float? @db.DoublePrecision // Latitude of service location
  longitude Float? @db.DoublePrecision // Longitude of service location

  // 📍 GEOLOCATION: Original GPS location (before any manual editing)
  latitude_original  Float? @db.DoublePrecision // Original GPS latitude
  longitude_original Float? @db.DoublePrecision // Original GPS longitude

  // 🆕 GEOLOCATION AUDIT: Track location source and edits
  location_source    LocationSource? // Enum: GPS_AUTO, GPS_MANUAL, USER_MANUAL, NONE
  location_edited_by String? // User ID who edited location (if applicable)
  location_edited_at DateTime? // When location was edited

  // 🆕 RECORD ORIGIN: Track where the record was created
  created_from RecordOrigin @default(WEB_DASHBOARD) // Enum: MOBILE_APP, WEB_DASHBOARD

  // The `Idempotency-Key` of the create that made this row, when the client
  // sent one: a create retried after a lost response returns this row instead
  // of opening a second service order. Unique per company (below), the same
  // pattern as Fuel and VehicleChecklist (ADR 0006).
  client_submission_id String?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  vehicleId String

  responsibleUser   User   @relation(fields: [responsibleUserId], references: [id])
  responsibleUserId String

  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId String

  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?

  parts           ServiceOrderPart[]
  accountsPayable AccountPayable[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([businessId, client_submission_id])
  // There was no tenant index at all here, so this was a sequential scan.
  // listServiceOrders; a history table that only grows.
  @@index([businessId, created_at])
  // One per foreign key, for the deletes of the referenced rows (see Vehicle).
  @@index([branchId])
  @@index([responsibleUserId])
  @@index([supplierId])
  @@index([vehicleId])
  @@map("service_order")
}

model ServiceOrderPart {
  id                  String   @id @default(uuid(7))
  unit_price          Decimal  @db.Decimal(10, 2)
  quantity            Int
  discount_percentage Decimal? @default(0) @db.Decimal(5, 2)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  serviceOrderId String

  part   Part   @relation(fields: [partId], references: [id])
  partId String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // No index at all before: the service-order listing includes `parts`,
  // which Prisma issues as WHERE "serviceOrderId" IN (...) — a scan of every
  // tenant's parts on every page.
  @@index([serviceOrderId])
  @@index([partId])
  @@index([businessId])
  @@map("service_order_part")
}

enum AccountPayableCategory {
  FUEL
  MAINTENANCE
  INSURANCE
  TAXES_FEES
  FINES
  TOLLS
  RENTAL
  PAYROLL
  OTHER
}

model AccountPayable {
  id           String    @id @default(uuid(7))
  issue_date   DateTime  @default(now())
  due_date     DateTime
  payment_date DateTime?
  amount       Decimal   @db.Decimal(10, 2)
  amount_paid  Decimal?  @db.Decimal(10, 2)

  // What the bill is about — the first question a management report asks.
  // Nullable because legacy rows predate the field; the form requires it.
  category             AccountPayableCategory?
  category_description String? // free text, only meaningful with OTHER

  // The `Idempotency-Key` of the create that made this row, when the client
  // sent one. See ServiceOrder.client_submission_id.
  client_submission_id String?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId String

  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  serviceOrderId String?

  // The person responsible for the bill, chosen in the form (a driver may be
  // one and sees theirs, decision 4.5). Who typed it is createdBy.
  registrationUser   User   @relation("AccountPayableResponsible", fields: [registrationUserId], references: [id])
  registrationUserId String

  // Decision 8.4: who is paid, what for and which vehicle carries the cost.
  // The payee is a registered supplier OR free text (payee_name) — a toll
  // booth or a one-off mechanic is not worth a supplier record. SET NULL on
  // both: deleting a supplier or a vehicle must not delete a bill, and the
  // payee_name/description keep the bill readable.
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierId String?

  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleId String?

  payee_name      String?
  description     String?
  document_number String?

  // Who registered it. Null for legacy rows (registrationUserId used to mean
  // both) and after that user is deleted — a bill outlives its typist.
  createdBy   User?   @relation("AccountPayableCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([businessId, client_submission_id])
  // There was no tenant index at all here, so this was a sequential scan.
  // listAccountPayables; an accumulating financial table.
  @@index([businessId, created_at])
  // The bills of one payee and of one vehicle (cost centre), and the SET NULL
  // when either is deleted. Not (businessId, supplierId): a supplier or a
  // vehicle belongs to exactly one company, so the key alone is as selective
  // and a tenant-led twin would be a second index on the same rows.
  @@index([supplierId])
  @@index([vehicleId])
  // One per foreign key, for the deletes of the referenced rows (see Vehicle).
  @@index([branchId])
  @@index([registrationUserId])
  @@index([serviceOrderId])
  @@index([createdById])
  @@map("account_payable")
}

model Activity {
  id                 String    @id @default(uuid(7))
  type               String // "vehicle", "user", "service-order", etc.
  action             String // "create", "update", "delete", etc.
  entityId           String
  description        String
  status             String
  businessId         String?
  tenantName         String? // Snapshot of business name at creation time — preserved after deletion
  visibilityLevel    String? // "SYSTEM", "COMPANY", "USER" - controls hierarchical visibility
  performingUserRole String? // Role of user who performed the action
  business           Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user               User?     @relation(fields: [performedBy], references: [id], onDelete: SetNull)
  performedBy        String?

  // Set only when the row came from the notification pipeline, and unique so
  // a redelivery cannot write the same activity twice. Deliberately NOT a
  // foreign key: deliveries are purged on a schedule and the activity trail
  // has to outlive them — a cascade here would quietly erase history.
  deliveryId String? @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Both compounds replace single-column indexes of the same write cost, so
  // the sort disappears for free — and "for free" is the whole argument on a
  // table written by every action of every user.
  @@index([businessId, created_at])
  @@index([performedBy, created_at])
  // The BUSINESS_ADMIN trail's total (count with "not by a MASTER, or
  // tenant-visible"): an index-only scan of the company's entries, joined to
  // the few users by performedBy. Few distinct triples, so B-tree
  // deduplication keeps it small; without it the count visited every row of
  // the trail (db-perf 10/2026: 288 ms -> 107 ms on 300k rows).
  @@index([businessId, performedBy, visibilityLevel])
  // ([visibilityLevel]) removed: three possible values, no tenant in front,
  // and it only ever appears as one branch of an OR inside an already
  // tenant-scoped query. The planner never picks it as the driving index.
  @@index([created_at])
  @@map("activity")
}

// For notifications targeted to specific users
model Notification {
  id         String    @id @default(uuid(7))
  type       String // "service-order", "vehicle", etc.
  title      String
  message    String
  link       String?
  read       Boolean   @default(false)
  entityId   String?
  businessId String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String // recipient user ID
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Set when the notification pipeline created this row. The unique
  // constraint is what makes the IN_APP channel idempotent: a delivery
  // retried after a crash can't insert the same notification twice.
  deliveryId String? @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // The single highest-frequency query in the product: the bell, polled by
  // every one of 150k users. It was an index scan on (userId) followed by a
  // sort of that user's entire history, on every poll.
  @@index([userId, created_at])
  // The unread badge and "Não lidas": the user's unread rows only. Under
  // (userId, created_at) the count visited every notification the user
  // still keeps to find the unread ones (db-perf 10/2026: 136 ms -> under
  // 1 ms with 30k kept). The created_at leg also orders the unread list.
  @@index([userId, read, created_at(sort: Desc)])
  // ([businessId]) removed: notification is never queried by business — every
  // access is by userId or by id.
  // ([read]) removed: a boolean, never queried without userId, and it is the
  // column markAsRead rewrites — so every click on a notification was also
  // rewriting an entry in a btree covering the whole history.
  // Declared so `migrate dev` stops offering to drop it. The nightly purge
  // orders by created_at; without this index each batch sorts the whole
  // expired set and the job runs out of budget before draining the table.
  @@index([created_at])
  @@map("notification")
}

// ============================================================================
// Notification pipeline (transactional outbox)
//
// Use cases publish a DomainOutboxEvent inside the same transaction as the
// business write — so an event exists if and only if the write committed.
// Background workers expand events into per-recipient, per-channel
// NotificationDelivery rows and execute them with persisted retries. Every
// claim uses FOR UPDATE SKIP LOCKED plus a lease, so any number of API
// replicas can run the workers without duplicating work.
// ============================================================================

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  ACTIVITY
  PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING

  /// For IN_APP and ACTIVITY: the row was written, which IS the delivery.
  /// For EMAIL, WHATSAPP and PUSH: the provider ACCEPTED the message — not
  /// that it reached anybody. What happened afterwards (read, bounced, a
  /// WhatsApp that failed asynchronously, a push token Expo no longer knows)
  /// is NotificationDelivery.providerStatus and the receipt ledger.
  DELIVERED
  FAILED
}

enum ScheduledJobExecutionStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model DomainOutboxEvent {
  id            String  @id @default(uuid(7))
  eventKey      String  @unique
  topic         String
  aggregateType String
  aggregateId   String
  businessId    String?
  actorId       String?
  payload       Json

  status         OutboxEventStatus @default(PENDING)
  availableAt    DateTime          @default(now())
  attempts       Int               @default(0)
  leaseExpiresAt DateTime?
  processedAt    DateTime?
  lastError      String?

  /// The id of the HTTP request that published the event (its x-request-id),
  /// so a log line, the event and every delivery it fanned out to can be
  /// found from the one id a customer or the support has. Null for events
  /// published outside a request (cron, workers). Not indexed: it is read
  /// while investigating, never on a hot path.
  correlationId String?

  deliveries NotificationDelivery[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Kept for /health/metrics (counts by status, oldest pending row) and for
  // the batched purge of FAILED rows. The claim itself no longer uses it: it
  // runs on the partial index domain_outbox_event_claim_idx, created in raw
  // SQL because Prisma cannot express a partial index. See
  // migrations/20260908120000_harden_queue_tables. The PUBLISHED purge reads
  // another raw partial index, domain_outbox_event_published_processed_idx
  // ("processedAt") WHERE status = 'PUBLISHED'
  // (migrations/20260924130100_outbox_published_processed_idx).
  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("domain_outbox_event")
}

model NotificationDelivery {
  id            String @id @default(uuid(7))
  outboxEventId String

  /// Exactly one of these is set, and a CHECK constraint enforces it.
  ///
  /// The recipient of a delivery never logs in — they are a phone number and
  /// an e-mail on a note — so the ledger had to learn to address somebody who
  /// is not a User. One ledger and not two: the retry loop, the lease, the
  /// dedupe key and the provider bookkeeping are the hard parts, and a
  /// parallel table for external sends would be a second copy of all of them,
  /// drifting.
  userId              String?
  externalRecipientId String?

  channel NotificationChannel

  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  availableAt    DateTime                   @default(now())
  leaseExpiresAt DateTime?
  deliveredAt    DateTime?
  lastError      String?

  // What the provider called this message. The only way, after the fact, to
  // ask a provider what happened to one specific notification — and the only
  // evidence that distinguishes "we sent it twice" from "they received it
  // twice" when a customer reports a duplicate.
  //
  // Kept as long as the row: 30 days after the event was processed for a
  // DELIVERED row (the purge cascades from the event). A FAILED row is copied
  // to NotificationDeadLetter before that purge and kept there for 90 days.
  providerMessageId String?

  /// The latest status the PROVIDER reported after accepting the message —
  /// Meta's sent/delivered/read/failed, Resend's delivered/bounced/complained,
  /// Expo's receipt — and when. Null until a callback or a receipt arrives,
  /// and always for IN_APP/ACTIVITY. Moves forward only: a late 'delivered'
  /// never overwrites 'read', and 'failed' is final. The full history, one
  /// row per report, is NotificationProviderReceipt.
  providerStatus   String?
  providerStatusAt DateTime?

  event DomainOutboxEvent @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)
  user  User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  externalRecipient ExternalRecipient? @relation(fields: [externalRecipientId], references: [id], onDelete: Cascade)

  receipts NotificationProviderReceipt[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // One delivery ROW per event × recipient × channel, whatever crashes or how
  // many replicas run. Not one SEND: a channel that talks to a provider is
  // at-least-once — a worker that dies after the provider accepted and before
  // DELIVERED was recorded leaves the row to be sent again. E-mail closes that
  // gap at the provider (the delivery id is Resend's idempotency key);
  // WhatsApp and push cannot.
  //
  // Enforced by TWO PARTIAL unique indexes in raw SQL (see
  // migrations/20260916090000_external_recipient), one per kind of recipient:
  // a plain @@unique over a nullable column treats every NULL as distinct in
  // Postgres, so the external rows would have had no uniqueness at all and a
  // retried event would have inserted a second WhatsApp row.
  //
  // No ([status, availableAt]) index: the claim runs on one partial index per
  // delivery lane (raw SQL, created in
  // migrations/20260923120000_notification_delivery_lanes), keyed on
  // availableAt since 20260924091000_notification_delivery_claim_by_due so a
  // claim stops at now() instead of walking every row parked in backoff.
  //
  // Also raw SQL, because Prisma cannot declare a partial index (`migrate
  // diff` ignores them — never "clean them up"):
  //   notification_delivery_failed_idx ("updated_at", "channel")
  //     WHERE status = 'FAILED' — the dead letter and its count, the failures
  //     per channel on /health/metrics, and the dead-letter archiver. This
  //     table IS read by status; the old claim that it never was is wrong.
  //   notification_delivery_providerMessageId_idx ("providerMessageId")
  //     WHERE "providerMessageId" IS NOT NULL — a provider callback that
  //     carries only the provider's own id.
  //
  // ([outboxEventId]) is for the purge: the cascade from a deleted event
  // deletes by outboxEventId alone, which the partial uniques cannot serve —
  // without it, one sequential scan per purged event.
  //
  // No index on created_at, on purpose. A BRIN was tried (20260924091100) and
  // dropped (20260924130000): every claim and settle moves `status`, so no
  // UPDATE here is HOT, new row versions land in old pages the purge freed, a
  // BRIN range only widens, and the planner still picked it over a btree — a
  // one-day window read the whole table. Time windows over this table read a
  // range of the uuid v7 primary key instead (metrics-queries.ts,
  // deliveryIdFloor).
  @@index([outboxEventId])
  @@index([userId])
  @@index([externalRecipientId])
  @@map("notification_delivery")
}

/// What a provider told us about one message after accepting it, one row per
/// report.
///
/// The ledger behind NotificationDelivery.providerStatus. The column holds the
/// latest word; this holds every word, which answers the two questions a
/// column cannot: "did we send it twice?" — more than one wamid for one
/// delivery: WhatsApp has no idempotency key, so a worker that dies after Meta
/// accepted and before DELIVERED was recorded sends again — and "which
/// device's push failed?" — one push delivery is one Expo ticket per device.
///
/// Providers retry their callbacks, so one report can arrive several times:
/// (provider, providerMessageId, status) is unique and inserts skip
/// duplicates.
model NotificationProviderReceipt {
  id String @id @default(uuid(7))

  /// Null when the report names a message no delivery can be tied to (a row
  /// already purged, or a send that predates the delivery id travelling with
  /// the message). Cascade: the ledger lives as long as what it explains.
  delivery   NotificationDelivery? @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryId String?

  /// 'meta' | 'resend' | 'expo'. Text rather than an enum: a provider is
  /// added by code alone, while a new enum value could only be written one
  /// release after it was created (expand/contract).
  provider String

  /// The provider's id for the message: the wamid, Resend's e-mail id, the
  /// Expo ticket id.
  providerMessageId String

  /// The provider's word, verbatim: Meta sent|delivered|read|failed, Resend's
  /// event type, Expo ticket|ok|error|expired.
  status String

  errorCode    String?
  errorMessage String?

  /// Expo only: the device token the ticket was issued for, so a
  /// DeviceNotRegistered receipt prunes exactly that device.
  pushToken String?

  /// When the provider says it happened.
  occurredAt DateTime

  /// Expo only: when the receipt was last asked for.
  checkedAt DateTime?

  created_at DateTime @default(now())

  @@unique([provider, providerMessageId, status])
  @@index([deliveryId])
  // The receipts job (Expo tickets not checked yet) and the metrics (failed
  // reports in the last 24 hours) both ask "this provider, this status,
  // recently".
  @@index([provider, status, created_at])
  @@map("notification_provider_receipt")
}

/// A delivery that exhausted its retries, copied out before the purge.
///
/// Deliveries live and die with their outbox event: the nightly purge deletes
/// PUBLISHED events 30 days after processing, and the cascade takes their
/// deliveries — the FAILED ones and their providerMessageId included, which
/// are exactly what somebody asks about five weeks later ("the customer never
/// got it"). The cleanup job copies each FAILED delivery here before that
/// purge and keeps it for 90 days.
///
/// No foreign keys on purpose: the row must outlive the event, the delivery,
/// the user and the recipient it describes, so everything needed to answer
/// "what failed, for whom and why" is copied.
model NotificationDeadLetter {
  /// The delivery's own id, so archiving the same row twice is a no-op.
  id String @id

  outboxEventId String
  topic         String
  businessId    String?

  userId              String?
  externalRecipientId String?

  channel  NotificationChannel
  attempts Int

  lastError         String?
  providerMessageId String?

  /// When the delivery was created and when it gave up (its updated_at),
  /// both copied.
  created_at DateTime
  failedAt   DateTime

  archived_at DateTime @default(now())

  /// The archive's listing (newest failure first) and its own purge.
  @@index([failedAt])
  @@map("notification_dead_letter")
}

enum NotificationCategory {
  FINES
  MAINTENANCE
  FINANCE
  TASKS
  ACCOUNT
  SYSTEM
}

// Per-user, per-category channel choices. A missing row means "no opinion":
// the legacy per-user toggles keep deciding, so shipping this table changed
// nobody's behavior. Topics marked mandatory deliver in-app regardless —
// the user controls noise, not critical account events.
model NotificationPreference {
  id       String               @id @default(uuid(7))
  userId   String
  category NotificationCategory

  inApp    Boolean @default(true)
  email    Boolean @default(true)
  whatsapp Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([userId, category])
  @@map("notification_preference")
}

// One row per device the user allowed push notifications on. The token is
// globally unique: a device that logs into another account is reassigned to
// the new user on registration, so pushes never reach a stale owner. Tokens
// the provider reports as dead (DeviceNotRegistered) are pruned on delivery.
model PushDeviceToken {
  id       String @id @default(uuid(7))
  userId   String
  token    String @unique
  platform String

  /// The session (refresh-token family) that registered this device. A
  /// device belongs to a login, not only to a user: when that session ends —
  /// logout, reuse revocation, a forced logout — its push token goes with it,
  /// server-side, so a logged-out phone stops showing that user's messages
  /// even when the app's own unregister call lost the race or never left.
  /// Null for rows registered before the column existed; the app registers
  /// again on every launch, which fills it.
  session_family_id String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([userId])
  @@index([session_family_id])
  @@map("push_device_token")
}

// Leader election for cron jobs: every replica fires on schedule and tries to
// insert (jobName, scheduledFor); the unique constraint lets exactly one win.
// The lease allows a takeover if the winner dies mid-run.
model ScheduledJobExecution {
  id           String                      @id @default(uuid(7))
  jobName      String
  scheduledFor DateTime
  status       ScheduledJobExecutionStatus @default(RUNNING)

  attempts       Int       @default(1)
  leaseExpiresAt DateTime?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  lastError      String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([jobName, scheduledFor])
  // "When did each job last succeed?" (/health/metrics) and "which runs were
  // left RUNNING by a replica that died?" (the sweep before each firing).
  @@index([status, jobName, finishedAt])
  @@map("scheduled_job_execution")
}

// Where each worker of each replica was last seen alive.
//
// The workers guard their cycles with in-memory flags: a cycle stuck on an
// await that never returns keeps its flag set and silently stops that
// replica's worker, and nothing outside the process can tell. Each replica
// flushes its in-memory heartbeats here every half minute, so /health/metrics
// and the alerting leader see every replica, not only the one that answered.
// A handful of rows (replicas × workers), rewritten in place.
model WorkerHeartbeat {
  /// The container's hostname.
  replica String
  worker  String

  /// The last sign of progress, and when the current cycle started (null
  /// between cycles). Stuck = runningSince set and lastBeatAt too old.
  lastBeatAt   DateTime
  runningSince DateTime?

  /// Defaulted in the database too: the flush is one raw
  /// INSERT ... ON CONFLICT DO UPDATE, which must set it on the update side.
  updated_at DateTime @default(now()) @updatedAt

  @@id([replica, worker])
  @@map("worker_heartbeat")
}

enum AIAnalysisType {
  FUEL_ODOMETER
  CHECKLIST

  /// The receipt photo a driver sends back. The verdict is a SUGGESTION: a
  /// machine reading of a photo does not close a probative cycle, and the
  /// human queue is what does.
  DELIVERY_PROOF
}

enum AIAnalysisRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
  SKIPPED
}

enum AIAnalysisUnitStatus {
  RESERVED
  CONSUMED
  RELEASED
}

enum AIProviderAttemptStatus {
  SUCCEEDED
  FAILED
}

// Quota ledger: one row per business per calendar month. The limit itself
// stays on Business (single source of truth — raising it mid-month applies
// immediately); this row only counts what the month spent. Replaces the
// mutable ai_analysis_used counter and the monthly reset cron: a new month
// simply starts a new row, so history is kept and nothing is ever zeroed.
model AIUsagePeriod {
  id          String   @id @default(uuid(7))
  businessId  String
  periodStart DateTime @db.Date

  reservedUnits Int @default(0)
  consumedUnits Int @default(0)

  requests AIAnalysisRequest[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([businessId, periodStart])
  @@map("ai_usage_period")
}

// Every AI job is a row: auditable, idempotent and retryable in place.
// Replaces the fire-and-forget RabbitMQ message. The idempotency key hashes
// type + record + input, so re-running a usecase never duplicates a job while
// a genuinely new input (photo replaced, mileage edited) creates a new one.
model AIAnalysisRequest {
  id             String         @id @default(uuid(7))
  idempotencyKey String         @unique
  type           AIAnalysisType
  recordId       String
  businessId     String
  periodId       String
  requestedById  String
  input          Json

  status         AIAnalysisRequestStatus @default(PENDING)
  attempts       Int                     @default(0)
  availableAt    DateTime                @default(now())
  leaseExpiresAt DateTime?
  completedAt    DateTime?
  lastError      String?

  period AIUsagePeriod    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  units  AIAnalysisUnit[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Kept for /health/metrics (PENDING and PROCESSING counts) and for the
  // batched purge over the terminal statuses. The claim runs on the partial
  // index ai_analysis_request_claim_idx (raw SQL, see
  // migrations/20260908120000_harden_queue_tables).
  //
  // The fair claim (oldest request of each tenant first, so one tenant's
  // burst cannot starve the others) reads the backlog in (businessId,
  // created_at) order from ai_analysis_request_fair_claim_idx — partial on
  // PENDING/PROCESSING, so raw SQL (20260924091500_ai_analysis_request_fair_claim).
  @@index([status, availableAt])
  @@index([type, recordId])
  // ON DELETE CASCADE from the usage period.
  @@index([periodId])
  @@map("ai_analysis_request")
}

// One billable provider call: a checklist field or the odometer photo. Quota
// is reserved when the unit is created, then either consumed on success or
// released when retries are exhausted — a crash anywhere in between can only
// leave a reservation for the lease/retry machinery to settle, never a
// double charge.
model AIAnalysisUnit {
  id        String @id @default(uuid(7))
  requestId String
  unitKey   String

  status     AIAnalysisUnitStatus @default(RESERVED)
  result     Json?
  lastError  String?
  consumedAt DateTime?
  releasedAt DateTime?

  request  AIAnalysisRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  attempts AIProviderAttempt[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([requestId, unitKey])
  @@map("ai_analysis_unit")
}

// Attempt trail: one row per provider call with token counts, so cost and
// failure history are auditable per unit.
model AIProviderAttempt {
  id        String @id @default(uuid(7))
  unitId    String
  attemptNo Int

  provider     String
  model        String
  status       AIProviderAttemptStatus
  inputTokens  Int?
  outputTokens Int?
  durationMs   Int?
  errorMessage String?

  unit AIAnalysisUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([unitId, attemptNo])
  @@map("ai_provider_attempt")
}

model Quote {
  id           String      @id @default(uuid(7))
  name         String
