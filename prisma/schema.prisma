// ── Deliveries module ────────────────────────────────────────────────────

// Delivery or pickup. The operation treats them as two kinds of the same
// record, not as two flows — same route, same driver, same proof.
enum DeliveryKind {
  DELIVERY
  PICKUP
}

enum RouteStatus {
  PLANNED // being assembled; the driver cannot see it
  RELEASED // handed to the driver, not yet departed
  IN_PROGRESS // the driver left
  COMPLETED // every stop resolved — reached on its own, never by a button
  CANCELLED // terminal
}

enum RouteStopStatus {
  PENDING
  ARRIVED
  COMPLETED
  FAILED
  CANCELLED
}

// A day's work for one driver in one vehicle: the entity the delivery module
// was missing. "Start route" used to be a verb — an updateMany moving every
// PENDING delivery of a driver to IN_TRANSIT — with nothing to consult,
// order, release, follow or close.
model Route {
  id String @id @default(uuid(7))

  // Sequential PER COMPANY, not globally. The id is already a UUID; this is
  // the number an operator says out loud and the proof document prints. A
  // global sequence would leak one carrier's volume to all the others — the
  // same enumeration leak the vehicle plate has today.
  code Int
  name String?

  status RouteStatus @default(PLANNED)

  // The operational day, kept apart from the execution timestamps: Tuesday's
  // route is planned on Monday and may leave late.
  scheduled_date DateTime

  planned_departure_at DateTime?
  planned_arrival_at   DateTime?

  started_at   DateTime?
  completed_at DateTime?

  // Required to cancel a route that already left, so the trail says why.
  cancellation_reason String?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  /// The upload that created this route, when one did. SetNull rather than
  /// Cascade: reversing an import removes what it created deliberately, one
  /// row at a time and only when nothing has happened to it — a cascade would
  /// take a route somebody has since worked.
  import   Import? @relation(fields: [importId], references: [id], onDelete: SetNull)
  importId String?

  driver   Driver @relation(fields: [driverId], references: [id])
  driverId String

  // Optional while planning, required to release — see canReleaseRoute.
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleId String?

  stops  RouteStop[]
  events DeliveryEvent[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([businessId, code])
  // Serves the panel: routes of a company by status and day.
  @@index([businessId, status, scheduled_date])
  // Serves the app: the released or running route of one driver.
  @@index([businessId, driverId, status])
  // A vehicle may be in at most ONE route in progress — the truck is on one
  // road. Enforced as a partial unique index in raw SQL (Prisma cannot
  // express the WHERE), see the migration. Declared here only as a comment so
  // nobody expects to find it in this file.
  @@index([importId])
  @@map("route")
}

// One delivery inside one route, in a chosen position.
model RouteStop {
  id String @id @default(uuid(7))

  // Manual order, set by dragging. Spaced by ten on insert so dropping a stop
  // between two others does not rewrite every row after it.
  sequence Int

  // The stop carries its own outcome rather than reading the delivery's,
  // because the same delivery can appear in more than one route over time.
  status RouteStopStatus @default(PENDING)

  arrived_at   DateTime?
  completed_at DateTime?

  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId String

  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryId String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([routeId, sequence])
  @@index([routeId, status])
  // A delivery may have at most ONE open stop across all routes. Also a
  // partial unique index in raw SQL — see the migration.
  @@index([deliveryId])
  @@map("route_stop")
}

enum DeliveryStatus {
  PENDING // created (manually or imported), not yet on route
  IN_TRANSIT // out with a driver
  DELIVERED // completed with proof of delivery
  FAILED // blocking occurrence — awaiting a redelivery decision
  CANCELLED // cancelled by management (terminal)
}

// Shipper = embarcador: the cargo owner a carrier delivers for. It is a
// dimension INSIDE the tenant (a carrier serves many shippers), never a
// second tenant — the delivery module is multi-shipper by design.
model Shipper {
  id String @id @default(uuid(7))

  name      String
  cnpj      String?
  email     String?
  telephone String?
  is_active Boolean @default(true)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  deliveries Delivery[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([businessId, name])
  @@index([businessId])
  @@map("shipper")
}

// Per-company occurrence catalog (Comprovei-style): the company defines its
// own vocabulary; blocking types flip the delivery to FAILED when reported.
model OccurrenceType {
  id String @id @default(uuid(7))

  name            String
  description     String?
  requires_photo  Boolean @default(false)
  blocks_delivery Boolean @default(false)
  is_active       Boolean @default(true)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  occurrences DeliveryOccurrence[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([businessId, name])
  @@index([businessId])
  @@map("occurrence_type")
}

enum ImportSource {
  SPREADSHEET
  NFE_XML
}

enum ImportStatus {
  /// Rows are being written. A crash leaves the upload here, and the rows
  /// it already created are reversible because they already carry its id.
  IN_PROGRESS

  COMPLETED
  REVERSED
}

/// One upload, and everything it created.
///
/// Exists so an import can be UNDONE. A dispatcher who loads the wrong file at
/// 6am — yesterday's sheet, the customer's other branch, a column shifted by
/// one — needs to take two hundred deliveries back out, and doing that by hand
/// is not doing it: they will miss some, and the ones they miss go out on a
/// truck.
///
/// The report is stored, not only returned. "Which of the two hundred failed?"
/// is asked hours later, by somebody who did not do the upload, and a report
/// that lived in one HTTP response cannot answer it.
/// Somebody a notification reaches who has no account.
///
/// The person waiting for a delivery is a phone number and an e-mail on a
/// note: they never log in, have no permissions and no preferences, and the
/// whole notion of "their profile" does not exist. They still have to be
/// addressable by the same pipeline, with the same providers, the same retry
/// loop and the same idempotency — so they get a row and an id, and the
/// delivery ledger points at it.
///
/// One row per delivery. A contact table keyed by phone would be tempting and
/// wrong at this size: the same number belongs to different people over time,
/// and a correction on one delivery must never rewrite the record of a message
/// already sent about another.
model ExternalRecipient {
  id String @id @default(uuid(7))

  name      String?
  email     String?
  telephone String?

  /// The link the person opens. Unguessable, and the only thing the public
  /// page accepts — there is no login behind it.
  access_token String @unique

  /// Null means it never expires. Set when a company wants tracking links to
  /// go dark after the delivery closes.
  expires_at DateTime?

  /// They asked to stop hearing from us. Checked before every send.
  opted_out_at DateTime?

  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryId String   @unique

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  deliveries NotificationDelivery[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([businessId, created_at])
  @@map("external_recipient")
}

/// The consolidated PDF a delivery leaves behind.
///
/// Generated once the delivery is proven, from the evidence already captured:
/// the fiscal data, the route, the declared address next to the coordinates
/// the phone actually recorded, who delivered it and on which device, the
/// signed receipt photo with its stamp, and the outcome occurrences.
///
/// The hash is the point. The public page recomputes the SHA-256 of the bytes
/// it serves and shows whether it still matches this row — which is what makes
/// the document a document rather than a picture somebody could have edited.
/// No ICP-Brasil signature in this slice, and the page says so: it asserts
/// facts that were captured, and claims no legal validity.
model DeliveryProofDocument {
  id String @id @default(uuid(7))

  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  /// One current document per delivery. A re-proof regenerates it, and the
  /// old bytes are replaced — two documents for one delivery is two answers
  /// to one question.
  deliveryId String   @unique

  /// Where the bytes live in the bucket.
  storage_key String

  /// Of the exact bytes stored, hex, lowercase.
  sha256 String

  /// What the QR code points at.
  verification_token String @unique

  size_bytes Int

  /// Bumped on every regeneration, so a customer holding an older printout can
  /// be told theirs is not the current one.
  version Int @default(1)

  generated_at DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([businessId, generated_at])
  @@map("delivery_proof_document")
}

/// What a company says to the person waiting for a delivery.
///
/// Per company and per topic, because the voice is theirs: a carrier that
/// addresses "prezado cliente" and one that uses the shipper's brand are both
/// right, and a single hard-coded sentence would make the product speak over
/// them. Rendered with the same Handlebars the transactional mails already
/// use, over a documented variable set.
model DeliveryMessageTemplate {
  id String @id @default(uuid(7))

  /// Which moment it speaks at.
  topic DeliveryMessageTopic

  channel NotificationChannel

  /// Ignored by WhatsApp and SMS-shaped channels, which carry no subject.
  subject String?

  body String

  is_active Boolean @default(true)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /// One template per company × moment × channel. A second one would make
  /// which sentence goes out a matter of row order.
  @@unique([businessId, topic, channel])
  @@map("delivery_message_template")
}

enum DeliveryMessageTopic {
  /// The load is on its way and here is the link to follow it.
  DISPATCHED

  /// It is done, and here is the receipt.
  DELIVERED

  /// It could not be delivered, and why.
  FAILED
}

/// Where a receipt waits for a person to look at it.
///
/// The AI reads the photo and suggests; this row is where somebody decides.
/// The two are deliberately separate columns: the suggestion is evidence about
/// the photo, the verdict is a decision about the delivery, and collapsing
/// them would make it impossible to ask afterwards how often the machine was
/// right — which is the only way to know whether to keep paying for it.
model DeliveryProofAudit {
  id String @id @default(uuid(7))

  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  /// One audit per delivery. A re-proof replaces the suggestion and reopens
  /// the row rather than queueing a second card for the same address.
  deliveryId String   @unique

  status ProofAuditStatus @default(PENDING)

  /// What the model concluded, criterion by criterion. Null until it answers —
  /// and a null here is why the card still shows: a photo the AI could not
  /// read is exactly the one a person has to.
  ai_suggestion Json?

  /// Between 0 and 1, from the model. Used to order the queue: the least
  /// certain readings are the ones a person adds the most value to.
  ai_confidence Float?

  ai_analyzed_at DateTime?

  reviewedBy   User?   @relation(fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedById String?

  reviewed_at DateTime?

  /// Why a person rejected it. Required on a rejection by the use case: a
  /// receipt refused with no reason is a receipt nobody can act on.
  rejection_reason String?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /// The queue's only read: what is still waiting, for this company, oldest
  /// first. Partial on PENDING would be better and Prisma cannot express it —
  /// the raw SQL in the migration adds that one.
  @@index([businessId, status, created_at])
  @@map("delivery_proof_audit")
}

enum ProofAuditStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A key an outside system authenticates with.
///
/// The contract is OURS: a versioned public API and a versioned catalogue of
/// webhook topics, the same for any TMS, ERP or router. Whoever connects to us
/// adapts to our contract — a connector per customer is a connector per
/// customer to maintain, forever, and the reference product taught that the
/// hard way.
model ApiKey {
  id String @id @default(uuid(7))

  /// What a person calls it when they revoke one: "ERP Protheus", "Fusion".
  /// Without a name, revoking the right key means guessing.
  name String

  /// The visible half, shown in the list and carried in logs. The secret half
  /// is never stored — only its hash — so a database dump does not hand
  /// somebody the keys to every customer's operation.
  prefix String @unique

  token_hash String

  /// What this key may do. Checked per route: a key an ERP uses to read routes
  /// has no business creating deliveries, and the day that ERP is compromised
  /// the blast radius is the scope somebody chose.
  scopes String[]

  /// Per key, not per company: one integration hammering us must not spend the
  /// budget of another integration of the same customer.
  rate_limit_per_minute Int @default(120)

  /// Answers "is this key still used?" before somebody revokes it.
  last_used_at DateTime?

  /// Revoked, not deleted. A key that made calls is part of the answer to what
  /// happened, and deleting it would take the trail with it.
  revoked_at DateTime?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  usage ApiKeyUsageDaily[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([businessId, created_at])
  @@map("api_key")
}

/// What a customer's system asked of us, counted.
///
/// The inverse of `WebhookDelivery`, and the question support actually gets
/// first: not "did you send it" but "did their ERP call, and what happened?".
/// Without this the only answer available is `last_used_at`, which says
/// somebody called something at some point.
///
/// Aggregated rather than a row per request. At five million deliveries a
/// month a request log is tens of millions of rows a month to answer a
/// question that is always a count.
model ApiKeyUsageDaily {
  id String @id @default(uuid(7))

  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  apiKeyId String

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  /// UTC. A date and not a timestamp: the question is "how many yesterday",
  /// never "how many at 14:32".
  day DateTime @db.Date

  method String

  /// The route PATTERN, not the URL. Aggregating by literal URL would give one
  /// row per document anybody looked at — the request log again, renamed.
  route String

  /// 2, 4 or 5: it worked, they got it wrong, or we did. Those are the three
  /// conversations. The exact status stays in the application log.
  status_class Int @db.SmallInt

  count BigInt @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([apiKeyId, day, method, route, status_class], map: "api_key_usage_daily_bucket_key")
  @@index([businessId, day(sort: Desc)])
  @@map("api_key_usage_daily")
}

/// Where each driver is NOW, apart from where they have been.
///
/// The tower used to read the latest row per driver out of `DriverPosition`
/// with `DISTINCT ON`. Measured against one day of one tenant — 261.000 rows —
/// that was a sequential scan plus a 14 MB on-disk sort, 408 ms in the
/// database, to return forty rows. The cost grew with the number of PINGS
/// rather than with the number of drivers, and the capacity ruler puts pings
/// at 670 a second.
///
/// One row per driver, rewritten on each flush. The tower reads by index what
/// it always wanted, and `DriverPosition` goes back to being what it always
/// was: the trail.
model DriverLastPosition {
  /// The driver IS the key. There is no such thing as two current positions.
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId String @id

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  routeId String?

  latitude  Float
  longitude Float

  accuracy Float?
  speed    Float?
  heading  Float?

  battery Int? @db.SmallInt

  /// From the device, as in the trail.
  recorded_at DateTime

  updated_at DateTime @updatedAt

  @@index([businessId, recorded_at(sort: Desc)])
  @@map("driver_last_position")
}

/// Where a driver was, while a route of theirs was running.
///
/// The only table in the product that grows with TIME rather than with a
/// business event: three hundred drivers pinging every thirty seconds is
/// 864.000 rows a day. Partitioned by day in the database (Prisma cannot
/// express it, the migration does), so the purge is a DROP TABLE of one
/// partition rather than a delete of a million rows.
///
/// No relations to Driver or Business on purpose. A foreign key makes every
/// INSERT check the referenced table, and this is the hottest write path in
/// the product for data whose only reader is a map. An orphan position is a
/// dot that does not draw, not corruption.
model DriverPosition {
  id String @default(uuid(7))

  driverId   String
  businessId String

  /// The route that was running. Without it the trail is dots with no
  /// context: "where was the driver" only helps next to "doing what".
  routeId String?

  latitude  Float
  longitude Float

  /// Metres, from the device's GPS. A point with a hundred metres of error
  /// puts the truck on the wrong block, and the screen has to be able to
  /// throw it away.
  accuracy Float?

  speed   Float?
  heading Float?

  battery Int? @db.SmallInt

  /// When the DEVICE recorded it, never when it arrived. A driver crosses a
  /// dead zone and the app flushes twenty points at once; the arrival time
  /// would collapse half an hour of road into one instant.
  recorded_at DateTime

  created_at DateTime @default(now())

  /// The partition key has to be in the primary key. Not Postgres bureaucracy:
  /// without it the unique index could not be local to each partition, and a
  /// global index would defeat the instant DROP.
  @@id([id, recorded_at])
  @@index([driverId, recorded_at(sort: Desc)])
  @@index([businessId, recorded_at(sort: Desc)])
  @@map("driver_position")
}

/// Where a customer's system wants to be told things.
model WebhookEndpoint {
  id String @id @default(uuid(7))

  name String
  url  String

  /// Signs every payload with HMAC-SHA256, so the receiver can prove the call
  /// came from us and not from somebody who learnt their URL.
  secret String

  /// Reusable authentication the receiver's own gateway wants — a bearer, an
  /// API key of theirs. Stored because the alternative is asking a customer to
  /// paste it on every event.
  headers Json?

  /// Which topics. An endpoint that subscribed to nothing is an endpoint that
  /// receives nothing, which is a valid and deliberate state.
  topics String[]

  is_active Boolean @default(true)

  /// Turned off by us after too many consecutive failures, so a dead endpoint
  /// stops costing every event a timeout. Distinct from `is_active`, which is
  /// the customer's own switch.
  disabled_at DateTime?

  consecutive_failures Int @default(0)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  deliveries WebhookDelivery[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([businessId, created_at])
  @@map("webhook_endpoint")
}

/// One attempt to tell one endpoint about one event.
///
/// The payload is COPIED rather than referenced, and that is the point: the
/// outbox is a work queue that gets purged, and a customer asking us to resend
/// last Tuesday's event must not depend on a row we deleted on Wednesday.
/// Separating the audit archive from the hot queue is the same decision §4.6
/// records for the notification tables.
model WebhookDelivery {
  id String @id @default(uuid(7))

  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  endpointId String

  topic String

  /// The outbox event this came from, for tracing one fact across both queues.
  /// A plain column and not a relation: the outbox row is purged long before
  /// this one, and a foreign key would either block the purge or null the
  /// trail.
  sourceEventId String?

  payload   Json
  signature String

  /// The exact bytes the signature covers.
  ///
  /// Separate from `payload` because JSONB is not a string: Postgres parses
  /// it, reorders the keys and drops duplicates, so `JSON.stringify` of what
  /// comes back is not what went in — and a signature over one does not verify
  /// the other. A retry three hours later has to post the same bytes as the
  /// first attempt, or a receiver that logged both cannot tell they are the
  /// same event.
  ///
  /// Nullable only for rows written before this column existed.
  signed_body String?

  status   WebhookDeliveryStatus @default(PENDING)
  attempts Int                   @default(0)

  availableAt    DateTime  @default(now())
  leaseExpiresAt DateTime?

  /// What their server said. The body is truncated — a customer debugging an
  /// integration needs the first kilobyte, not a megabyte of their own HTML
  /// error page multiplied by every event of the day.
  response_status Int?
  response_body   String?

  latency_ms Int?

  deliveredAt DateTime?
  lastError   String?

  /// Set when a person pressed resend. Distinguishes our retries from theirs,
  /// which is the first question when a duplicate is reported.
  resent_from_id String?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /// The monitor's read: what happened, for this company, newest first.
  @@index([businessId, created_at])
  @@index([endpointId, status])
  @@map("webhook_delivery")
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED

  /// Retries exhausted. Still resendable by hand within the replay window —
  /// which is why the payload lives here and not only in the outbox.
  FAILED
}

model Import {
  id String @id @default(uuid(7))

  source ImportSource
  status ImportStatus @default(COMPLETED)

  /// What the operator uploaded, for the report to name.
  filename String

  imported   Int @default(0)
  duplicated Int @default(0)
  invalid    Int @default(0)

  /// The per-row outcome, exactly as the operator saw it.
  report Json

  reversed_at DateTime?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  /// Who uploaded it. Restrict for the same reason the events use it: this is
  /// a record of something a person did.
  performedBy   User   @relation(fields: [performedById], references: [id], onDelete: Restrict)
  performedById String

  deliveries Delivery[]
  routes     Route[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([businessId, created_at])
  @@map("import")
}

/// Why somebody changed a delivery's status by hand.
///
/// A catalogue per company, exactly like OccurrenceType: the operation names
/// its own vocabulary, and support answers "why" with the company's words
/// rather than with free text nobody can group or count.
///
/// Deliberately flat — not scoped per target status. "Cliente recusou" only
/// makes sense for an Insucesso, and modelling that would be correct and
/// unasked for; the sibling catalogue is flat and the cost of being wrong is
/// an operator seeing one option too many.
model StatusChangeReason {
  id String @id @default(uuid(7))

  name        String
  description String?
  is_active   Boolean @default(true)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  events DeliveryEvent[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([businessId, name])
  @@index([businessId])
  @@map("status_change_reason")
}

model Delivery {
  id String @id @default(uuid(7))

  // Client-facing reference (order number) and the NFe backing the cargo.
  // invoice_key (44-digit access key) is the dedupe anchor for XML import.
  code           String?
  invoice_key    String?
  invoice_number String?

  recipient_name      String
  recipient_document  String?
  recipient_email     String?
  recipient_telephone String?

  cep            String?
  city           String
  uf             String
  street         String
  address_number String?
  complement     String?
  neighborhood   String?

  status         DeliveryStatus @default(PENDING)
  scheduled_date DateTime?
  delivered_at   DateTime?
  received_by    String? // who signed at the door

  notes String?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  /// The upload that created this delivery, when one did. See Import.
  import   Import? @relation(fields: [importId], references: [id], onDelete: SetNull)
  importId String?

  shipper   Shipper @relation(fields: [shipperId], references: [id])
  shipperId String

  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleId String?

  driver   Driver? @relation(fields: [driverId], references: [id])
  driverId String?

  // Delivery or pickup. Two kinds of the same record, not two flows: the
  // operation treats them alike and every endpoint, filter and card built
  // without this field would have to be revisited later. Cheap now.
  kind DeliveryKind @default(DELIVERY)

  items        DeliveryItem[]
  occurrences  DeliveryOccurrence[]
  events       DeliveryEvent[]

  /// The person waiting for it, when the company notifies them. At most one.
  externalRecipient ExternalRecipient?

  /// The consolidated PDF, once the delivery is proven. At most one.
  proofDocument DeliveryProofDocument?

  /// Where the receipt waits for a person to look at it. At most one.
  proofAudit DeliveryProofAudit?
  chatMessages ChatMessage[]

  // N:N with Route on purpose. A failed delivery re-enters on the NEXT day's
  // route as a new stop, and the previous stop stays exactly as it was — that
  // record is what answers "what happened to invoice X".
  stops RouteStop[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([businessId, invoice_key])
  // The default listing carries no status filter, so it needs businessId
  // leading and created_at behind it — otherwise every page is a top-N sort
  // over the tenant's whole history, and the paired count() sorts it again.
  @@index([businessId, created_at])
  // Superset of the old ([businessId, status]) at the same write cost: serves
  // the filtered listing AND countDeliveriesByStatus AND operationSummary,
  // now without the sort.
  @@index([businessId, status, created_at])
  // ([businessId, scheduled_date]) removed: scheduled_date appears in no
  // `where` anywhere in the codebase — only in an orderBy whose `where` is
  // (businessId, driverId, status), which that index cannot serve. It was a
  // dead index on the most-written table in the system.
  @@index([shipperId])
  // Kept on purpose despite looking redundant: every driver query is
  // (businessId, driverId, status), and driverId is far more selective than
  // businessId.
  @@index([driverId])
  // The reversal reads every row one upload created.
  @@index([importId])
  @@map("delivery")
}

model DeliveryItem {
  id String @id @default(uuid(7))

  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 3)
  unit        String?
  unit_value  Decimal? @db.Decimal(10, 2)

  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryId String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([deliveryId])
  @@map("delivery_item")
}

model DeliveryOccurrence {
  id String @id @default(uuid(7))

  description String?
  latitude    Float?
  longitude   Float?
  photos      String[] // storage paths — populated by the driver app slice

  // Outbox idempotency anchor: the driver app may resend after a dead
  // network; the same submission never becomes two occurrences.
  client_submission_id String? @unique

  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryId String

  occurrenceType   OccurrenceType @relation(fields: [occurrenceTypeId], references: [id])
  occurrenceTypeId String

  reportedBy   User   @relation(fields: [reportedById], references: [id])
  reportedById String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([deliveryId])
  @@map("delivery_occurrence")
}

// A driver appointment on a delivery: arriving at the address, proving the
// drop-off. Events, not columns on Delivery, because a redelivery attempt
// (FAILED -> PENDING -> IN_TRANSIT) legitimately produces a second arrival
// and the trail must keep both.
enum DeliveryEventType {
  ARRIVAL
  PROOF

  // The support timeline, from slice 8. A status moved by hand and a note
  // typed by an operator are facts about the delivery with nowhere to live
  // until now: the status was a column that changed and the note did not
  // exist, so "why is this Insucesso?" had no answer three days later.
  STATUS_CHANGE
  NOTE
}

/// Who produced an event, which the timeline has to show and cannot infer.
///
/// A person on the web, a person on a phone (with which phone), an external
/// system through the integration API, or the platform itself. Today every
/// event has a User behind it because every source does; the enum exists so
/// the first integration does not have to invent a service account to satisfy
/// a foreign key — and so the timeline can say "integração" rather than
/// naming whichever user the integration borrowed.
enum DeliveryEventActor {
  USER
  DRIVER_APP
  INTEGRATION
  SYSTEM
}

model DeliveryEvent {
  id String @id @default(uuid(7))

  type DeliveryEventType

  latitude  Float?
  longitude Float?

  // Storage keys validated against the bucket before they become rows.
  photo     String? // delivery receipt ("canhoto") — PROOF only
  signature String? // on-screen signature image — PROOF only

  received_by String?

  /// Who produced this. See DeliveryEventActor.
  actor DeliveryEventActor @default(USER)

  /// Which phone sent it — DRIVER_APP only. Support is regularly asked to
  /// tell two devices of the same driver apart.
  device String?

  /// Free annotation. Required on a NOTE, optional alongside a STATUS_CHANGE
  /// where the reason carries the category and this carries the detail.
  note String?

  // STATUS_CHANGE only: what it was and what it became. Stored rather than
  // derived from the previous event, because the trail has to stay readable
  // even if an earlier event is ever removed — and because a delivery's
  // status also moves through paths that do not write an event.
  status_from DeliveryStatus?
  status_to   DeliveryStatus?

  /// STATUS_CHANGE only. Required by the use case, nullable in the column:
  /// the events written before this existed have none, and backfilling a
  /// reason nobody gave would be inventing the answer support is asking for.
  // Restrict, explicitly. An optional relation left implicit gets Prisma's
  // SetNull, and the reason a status was overridden would quietly disappear
  // the day somebody tidied the catalogue — taking with it the answer support
  // opens this timeline to find. Retiring a reason is `is_active`.
  reason   StatusChangeReason? @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  reasonId String?

  // Outbox idempotency anchor: the driver app may resend after a dead
  // network; the same submission never becomes two events.
  client_submission_id String? @unique

  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryId String

  // Which route this happened on, so support can answer "on which route" and
  // not only "on which delivery". SetNull rather than Cascade: the event IS
  // the record, and has to outlive anything that might remove the route.
  route   Route?  @relation(fields: [routeId], references: [id], onDelete: SetNull)
  routeId String?

  // Optional from slice 8, for the actors that are not a person: an
  // integration has no User and would otherwise need a service account
  // invented purely to satisfy this key.
  //
  // Restrict is explicit and load-bearing. Making an optional relation
  // implicit would hand Prisma its SetNull default, and the author of a
  // historical event would quietly vanish when a user is removed — the same
  // silent history loss the driver and vehicle deletes were just fixed for.
  reportedBy   User?   @relation(fields: [reportedById], references: [id], onDelete: Restrict)
  reportedById String?

  created_at DateTime @default(now())

  @@index([deliveryId])
  // The timeline reads one delivery newest-first. Without the created_at leg
  // that is an index scan followed by a sort of everything the delivery ever
  // did — cheap today, and the trail only grows.
  @@index([deliveryId, created_at])
  @@map("delivery_event")
}

// ============================================================================
// Chat SAC × driver (Deliveries module, slice 6)
//
// One thread per driver per business: the dispatcher talks to the person,
// not to a delivery — a message references a delivery as optional context.
// Reads are per-user cursors, never per-message receipts: WhatsApp-style
// checks and unread counts are DERIVED by comparing cursors against
// created_at, which stays correct under horizontal scale by construction
// (no counter to increment, nothing to reconcile between replicas).

model ChatThread {
  id String @id @default(uuid(7))

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId String

  // Ordering key for the SAC's thread list, kept in the same transaction
  // that inserts a message — it can never drift from the messages.
  last_message_at DateTime?

  // Delivery cursors: everything created up to each instant is already on a
  // real device of that side. They live on the thread because a thread has
  // exactly one driver and one SAC team, so neither can denormalize.
  //
  // The staff side is a team, not a person: the cursor is the most advanced
  // confirmation from ANY agent's open panel, which is what "the base has
  // it" means to a driver. A MASTER never advances it — the vendor holding
  // a message is not the customer's operation holding it.
  driver_delivered_at DateTime?
  staff_delivered_at  DateTime?

  messages ChatMessage[]
  reads    ChatThreadRead[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([businessId, driverId])
  @@index([businessId, last_message_at])
  @@map("chat_thread")
}

enum ChatMessageKind {
  TEXT
  IMAGE
  AUDIO
}

// A message is an immutable operational record (who told the driver to move
// on stays on file) — there is no edit or delete, removal only cascades with
// the tenant.
model ChatMessage {
  id String @id @default(uuid(7))

  kind ChatMessageKind

  // The text, or the caption under an attachment.
  body String?

  // Storage key for IMAGE/AUDIO — validated against bucket and tenant
  // before it becomes a row, signed on read (presigned-PUT pattern).
  attachment_key String?

  // Audio length so the player can render before the file loads.
  duration_ms Int?

  // Optional context chip: "this message is about that delivery".
  delivery   Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  deliveryId String?

  // The same text fanned out to several drivers shares one broadcast id,
  // so the UI can label it as a mass notice.
  broadcast_id String?

  // Retry idempotency anchor: the send button may fire again after a dead
  // network; the same submission never becomes two messages.
  client_submission_id String? @unique

  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId String

  sender   User   @relation(fields: [senderId], references: [id])
  senderId String

  created_at DateTime @default(now())

  // Wider than it looks like it needs to be, on purpose. The ordered prefix
  // (threadId, created_at) still serves history pagination; the trailing
  // senderId is what lets the unread count filter inside the index instead of
  // scanning the whole table. One index doing both is 141 MB where two were
  // 287 — see the 20260910120000_chat_scale_indexes migration for the numbers.
  //
  // That migration also creates a GIN trigram index on `body` for the message
  // search, which Prisma has no syntax for: `migrate dev` will offer to drop
  // it. Say no.
  @@index([threadId, created_at, senderId])
  @@map("chat_message")
}

// One read cursor per participant per thread. The SAC side is a team: each
// agent keeps their own cursor, and "read by the company" is the most
// advanced one.
model ChatThreadRead {
  id String @id @default(uuid(7))

  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  last_read_at DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([threadId, userId])
  @@map("chat_thread_read")
}
