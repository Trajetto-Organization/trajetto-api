## Simulation Requests

# Run simulation - SYNC (≤5 routes - processed immediately)
POST {{baseUrl}}/simulations/run
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Simulação Teste - Sync",
    "description": "Simulação com 3 rotas processada sincronamente",
    "businessId": "{{businessId}}",
    "routes": [
        {
            "name": "Rota 1 - Brasília Centro",
            "origin": {
                "lat": -15.7801,
                "lng": -47.9292
            },
            "destination": {
                "lat": -15.8267,
                "lng": -48.0501
            }
        },
        {
            "name": "Rota 2 - Brasília Sul",
            "origin": {
                "lat": -15.8267,
                "lng": -48.0501
            },
            "destination": {
                "lat": -15.8697,
                "lng": -47.9208
            }
        },
        {
            "name": "Rota 3 - Retorno ao Centro",
            "origin": {
                "lat": -15.8697,
                "lng": -47.9208
            },
            "destination": {
                "lat": -15.7801,
                "lng": -47.9292
            }
        }
    ],
    "metadata": {
        "environment": "test",
        "purpose": "sync_processing_test"
    }
}

