## Routing Requests

###

# Calculate route - Brasília to Goiânia
POST {{baseUrl}}/routes/calculate
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "origin": {
        "lat": -15.7801,
        "lng": -47.9292
    },
    "destination": {
        "lat": -16.6869,
        "lng": -49.2646
    },
    "costPerKm": 2.5,
    "businessId": "{{businessId}}"
}

###

# Calculate route with waypoints - Brasília -> Anápolis -> Goiânia
POST {{baseUrl}}/routes/calculate
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "origin": {
        "lat": -15.7801,
        "lng": -47.9292
    },
    "destination": {
        "lat": -16.6869,
        "lng": -49.2646
    },
    "waypoints": [
        {
            "lat": -16.3281,
            "lng": -48.9534
        }
    ],
    "costPerKm": 3.0,
    "businessId": "{{businessId}}"
}

###

# Optimize route - Multiple points in Centro-Oeste
POST {{baseUrl}}/routes/optimize
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "coordinates": [
        {
            "lat": -15.7801,
            "lng": -47.9292,
            "name": "Brasília"
        },
        {
            "lat": -16.3281,
            "lng": -48.9534,
            "name": "Anápolis"
        },
        {
            "lat": -16.6869,
            "lng": -49.2646,
            "name": "Goiânia"
        }
    ],
    "businessId": "{{businessId}}"
}

###

# Create route - NO data calculated (UseCase calculates automatically) ⚡
POST {{baseUrl}}/routes/create
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Rota Brasília - Goiânia",
    "description": "Rota de teste Centro-Oeste - Auto-cálculo",
    "origin": {
        "lat": -15.7801,
        "lng": -47.9292,
        "address": "Brasília, DF"
    },
    "destination": {
        "lat": -16.6869,
        "lng": -49.2646,
        "address": "Goiânia, GO"
    },
    "status": "PENDING",
    "businessId": "{{businessId}}"
}

###

# Create route - COM calculated data (optimized - does not recalculate) 🚀
POST {{baseUrl}}/routes/create
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Rota Brasília - Goiânia Otimizada",
    "description": "Rota com dados pré-calculados",
    "origin": {
        "lat": -15.7801,
        "lng": -47.9292,
