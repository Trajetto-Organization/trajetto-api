    "coordinates": [
        {
            "lat": -15.7801,
            "lng": -47.9292,
            "name": "Brasília"
        },
        {
            "lat": -16.3281,
            "lng": -48.9534,
            "name": "Anápolis"
        },
        {
            "lat": -16.6869,
            "lng": -49.2646,
            "name": "Goiânia"
        }
    ],
    "businessId": "{{businessId}}"
}

