# Node.js Dependencies
/node_modules
# yarn.lock is the tracked lockfile here; a package-lock.json left behind
# by an accidental `npm install` resolves a different tree and must not
# reach the repository.
package-lock.json
/.pnp
.pnp.js
.yarn/install-state.gz
/.yarn

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.js
.pnp.js.*

# Temporary files
.vscode/
.idea/
.nyc_output/
coverage/

# Mutation testing (yarn test:mutation): Stryker sandbox and reports
.stryker-tmp/
reports/mutation/
node_modules.bak/

# Native compilation files (may vary depending on native compilation usage)
/build/
/out/
dist

# Terraform files
*.tfstate
*.tfstate.*
*.tfvars
**/.terraform/*

# Environment variables (never commit credentials)
.env*
!.env.example

# Service-account keys (the Firebase admin SDK key lives next to the repos,
# in google-firebase-services/). The API uses none; a copy here is a mistake.
*firebase-adminsdk*.json
*service-account*.json

# Cache files
.cache/
dist/

# Compilation/transpilation files
*.log
*.bak
*.swp
*.map
*.tsbuildinfo
dist/

# Files generated by your development environment or operating system
.DS_Store
Thumbs.db

# Upload files
tmp/*
!tmp/.gitkeep

# Load-test fixtures carry minted JWTs and an API key for the throwaway
# database. They are regenerated by `tests/load/seed.ts` in seconds, and a
# token in a repository is a token in every clone of it.
tests/load/fixtures/

# CI creates src/tmp for local uploads during the unit run; never content.
/src/tmp/

# Certificates and private keys. The proof-signing A1 certificate reaches the
# API only as PROOF_SIGNING_PFX_BASE64 (docs/variaveis-de-ambiente.md); the
# .pfx kept around while preparing that value, an age identity of the backup
# or an SSH deploy key must never be committed.
*.pfx
*.p12
*.pem
*.key
*-identity.txt
