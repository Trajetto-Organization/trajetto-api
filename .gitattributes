# Shell scripts run inside Linux containers; a CRLF checkout breaks their
# shebang, because "/bin/sh" followed by a carriage return is not an
# interpreter.
*.sh text eol=lf

# The OCR weights of the AI image (infra/ai-ocr/models), checked by SHA-256
# in the build: never converted, never diffed as text.
*.onnx binary

# The trajetto-postgres image (infra/postgres): its scripts in bin/ have no
# extension, and pgBackRest's ini and the params file break on a carriage
# return too.
infra/postgres/** text eol=lf

# The trajetto-pgbouncer image (infra/pgbouncer): its entrypoint and test
# script run in the container; a carriage return breaks them.
infra/pgbouncer/** text eol=lf
