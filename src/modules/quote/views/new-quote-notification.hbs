<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nova Solicitação de Orçamento</title>
    <style>
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        line-height: 1.6;
        color: #333;
        width: 100% !important;
        max-width: 600px !important;
        margin: 0 auto !important;
        padding: 20px;
        background-color: #f8f9fa;
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
      }
      .container {
        background: white;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        max-width: 600px !important;
        width: 100% !important;
        margin: 0 auto !important;
        box-sizing: border-box;
      }
      .header {
        text-align: center;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 2px solid #d81b60;
      }
      .logo {
        font-size: 28px;
        font-weight: bold;
        color: #d81b60;
        margin-bottom: 10px;
      }
      .title {
        color: #2c3e50;
        font-size: 24px;
        margin-bottom: 20px;
      }
      .info-card {
        background: #f8f9fa;
        border-left: 4px solid #d81b60;
        padding: 20px;
        margin: 20px 0;
        border-radius: 0 8px 8px 0;
      }
      .info-row {
        margin-bottom: 12px;
        overflow: hidden;
      }
      .info-label {
        font-weight: 600;
        color: #2c3e50;
        display: inline-block;
        width: 120px;
        vertical-align: top;
        margin-right: 15px;
      }
      .info-value {
        color: #495057;
        display: inline-block;
        width: calc(100% - 135px);
        vertical-align: top;
      }
      .message-section {
        background: #e3f2fd;
        border-radius: 8px;
        padding: 20px;
        margin: 20px 0;
      }
      .message-title {
        font-weight: 600;
        color: #1976d2;
        margin-bottom: 10px;
      }
      .cta-section {
        text-align: center;
        margin: 30px 0;
      }
      .cta-button {
        display: inline-block;
        background: linear-gradient(135deg, #d81b60, #c2185b) !important;
        color: white !important;
        padding: 15px 30px;
        text-decoration: none !important;
        border-radius: 8px;
        font-weight: bold;
        font-size: 16px;
        box-shadow: 0 4px 15px rgba(216, 27, 96, 0.3);
        transition: transform 0.2s ease;
        border: none !important;
      }
      .cta-button:hover {
        transform: translateY(-2px);
      }
      .footer {
        text-align: center;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #e9ecef;
        color: #6c757d;
        font-size: 14px;
      }
      .urgent-badge {
        display: inline-block;
        background: #ff5722;
        color: white;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: bold;
        margin-left: 10px;
      }
      @media (max-width: 600px) {
        .info-label {
          display: block;
          width: 100%;
          margin-bottom: 5px;
        }
        .info-value {
          display: block;
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <div class="logo">🚛 Trajetto</div>
        <h1 class="title">Nova Solicitação de Orçamento
          <span class="urgent-badge">URGENTE</span></h1>
      </div>

      <div class="info-card">
        <div class="info-row">
          <span class="info-label">👤 Cliente:</span>
          <span class="info-value">{{clientName}}</span>
        </div>
        <div class="info-row">
          <span class="info-label">🏢 Empresa:</span>
          <span class="info-value">{{company}}</span>
        </div>
        <div class="info-row">
          <span class="info-label">📧 E-mail:</span>
          <span class="info-value"><a
              href="mailto:{{email}}"
              style="color: #d81b60;"
            >{{email}}</a></span>
        </div>
        <div class="info-row">
          <span class="info-label">📱 Telefone:</span>
          <span class="info-value"><a
              href="tel:{{telephone}}"
              style="color: #d81b60;"
            >{{telephone}}</a></span>
        </div>
        <div class="info-row">
          <span class="info-label">🚗 Frota:</span>
          <span class="info-value"><strong>{{fleetSize}}</strong></span>
        </div>
        <div class="info-row">
          <span class="info-label">🆔 ID Solicitação:</span>
          <span class="info-value"><code>{{quoteId}}</code></span>
        </div>
      </div>

      {{#if message}}
        <div class="message-section">
          <div class="message-title">💬 Mensagem do Cliente:</div>
          <p style="margin: 0; white-space: pre-wrap;">{{message}}</p>
        </div>
      {{/if}}

      <div class="cta-section">
        <a
          href="{{dashboardUrl}}"
          class="cta-button"
          style="color: white !important; text-decoration: none !important; background: linear-gradient(135deg, #d81b60, #c2185b) !important;"
        >
          🔍 Ver Detalhes no Dashboard
        </a>
      </div>

      <div
        style="background: #fff3cd; border: 1px solid #ffeaa7; border-radius: 8px; padding: 15px; margin: 20px 0;"
      >
        <p style="margin: 0; color: #856404;">
          <strong>⏰ Ação Recomendada:</strong>
          Entre em contato com o cliente em até 2 horas para maximizar a
          conversão.
        </p>
      </div>

      <div class="footer">
        <p>Este é um e-mail automático do sistema Trajetto.</p>
        <p>Solicitação recebida em
          {{year}}
          •
          <a href="{{dashboardUrl}}" style="color: #d81b60;">Acessar Dashboard</a></p>
      </div>
    </div>
  </body>
</html>