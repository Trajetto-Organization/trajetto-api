{
  "uid": "trajetto-processos",
  "title": "Trajetto · processos",
  "description": "Os processos da imagem trajetto-api, réplica por réplica, pelo /metrics de cada uma. Gerado por `yarn monitoring:render` (infra/monitoring/monitoring-config.ts): mude pelo repositório, nunca pelo painel.",
  "tags": ["trajetto"],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Ambiente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "definition": "label_values(trajetto_build_info, env)",
        "query": {
          "query": "label_values(trajetto_build_info, env)",
          "refId": "env"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1
      },
      {
        "name": "job",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "definition": "label_values(trajetto_build_info{env=\"$env\"}, job)",
        "query": {
          "query": "label_values(trajetto_build_info{env=\"$env\"}, job)",
          "refId": "job"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Respostas por grupo de rota",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (group) (rate(trajetto_http_responses_total{env=\"$env\", job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{group}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Respostas 5xx, 429 e 503",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (group) (rate(trajetto_http_responses_total{env=\"$env\", job=~\"$job\", class=\"5xx\"}[$__rate_interval]))",
          "legendFormat": "5xx {{group}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (group) (rate(trajetto_http_throttled_total{env=\"$env\", job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "429 {{group}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (group) (rate(trajetto_http_unavailable_total{env=\"$env\", job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "503 {{group}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Duração p95 por grupo de rota",
      "description": "Alvos propostos em docs/slo.md: listas e detalhes < 300 ms, posições < 250 ms, envios do motorista < 500 ms.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.95, sum by (group, le) (rate(trajetto_http_request_duration_seconds_bucket{env=\"$env\", job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "{{group}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Event loop: utilização",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "trajetto_event_loop_utilization{env=\"$env\", job=~\"$job\"}",
          "legendFormat": "{{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Event loop: atraso p99",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "trajetto_event_loop_lag_p99_seconds{env=\"$env\", job=~\"$job\"}",
          "legendFormat": "{{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memória residente",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "trajetto_process_resident_memory_bytes{env=\"$env\", job=~\"$job\"}",
          "legendFormat": "rss {{job}} {{instance}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "trajetto_process_heap_used_bytes{env=\"$env\", job=~\"$job\"}",
          "legendFormat": "heap {{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Pool do Prisma",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (pool) (trajetto_db_pool_connections{env=\"$env\", job=~\"$job\"})",
          "legendFormat": "{{pool}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(trajetto_db_pool_limit{env=\"$env\", job=~\"$job\"})",
          "legendFormat": "teto"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Sockets",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (job) (trajetto_sockets_connected{env=\"$env\", job=~\"$job\"})",
          "legendFormat": "{{job}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (job) (trajetto_sockets_cap{env=\"$env\", job=~\"$job\"})",
          "legendFormat": "teto {{job}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Processos no ar",
      "description": "Papel, ambiente e commit de cada réplica; duas linhas de commit diferentes por muito tempo é o alerta mixed-versions.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "trajetto_build_info{env=\"$env\", job=~\"$job\"} * on (env, job, instance) group_left () trajetto_process_uptime_seconds{env=\"$env\", job=~\"$job\"}",
          "legendFormat": "{{job}} {{instance}} {{role}} {{commit}}",
          "format": "table",
          "instant": true
        }
      ]
    }
  ]
}
